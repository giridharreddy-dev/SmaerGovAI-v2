{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SmartGov Scheme Schema",
  "description": "Validation schema for SmartGov welfare program catalog entries",
  "type": "object",
  "patternProperties": {
    "^.*$": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": ["Andhra Pradesh", "National"]
        },
        "category": {
          "type": "string",
          "description": "Healthcare category of this welfare scheme"
        },
        "icon": {
          "type": "string",
          "description": "Visual tag used for card icons in the landing UI"
        },
        "telugu_name": {
          "type": "string",
          "description": "Telugu translation of the scheme's display name"
        },
        "telugu_description": {
          "type": "string",
          "description": "Comprehensive Telugu summary / description for localized view and Guided Mode Slide 1"
        },
        "english_description": {
          "type": "string",
          "description": "Comprehensive English summary / description faithfully translated from Telugu"
        },
        "audio_file": {
          "type": "string",
          "description": "Relative path to pre-generated static audio MP3 file"
        },
        "source_name": {
          "type": "string"
        },
        "source_url": {
          "type": "string",
          "format": "uri"
        },
        "keywords": {
          "type": "array",
          "items": { "type": "string" }
        },
        "original_complex_text": {
          "type": "string",
          "description": "Full, unsimplified layout text of the welfare document"
        },
        "simplified": {
          "type": "object",
          "properties": {
            "eligibility": { "type": "string" },
            "benefits": { "type": "string" },
            "documents": { "type": "string" },
            "steps": { "type": "string" },
            "description": { "type": "string" }
          },
          "required": ["eligibility", "benefits", "documents", "steps"],
          "additionalProperties": false
        },
        "telugu": {
          "type": "object",
          "properties": {
            "eligibility": { "type": "string" },
            "benefits": { "type": "string" },
            "documents": { "type": "string" },
            "steps": { "type": "string" },
            "description": { "type": "string" }
          },
          "required": ["eligibility", "benefits", "documents", "steps"],
          "additionalProperties": false
        },
        "last_updated": {
          "type": "string",
          "format": "date"
        },
        "official_website": {
          "type": "string",
          "format": "uri"
        },
        "contact_office": {
          "type": "string"
        },
        "eligibility_confirmation": {
          "type": "string"
        },
        "eligibility_questions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question_te": { "type": "string" },
              "question_en": { "type": "string" },
              "weight": { "type": "string", "enum": ["critical", "high", "medium"] }
            },
            "required": ["question_te", "question_en", "weight"],
            "additionalProperties": false
          }
        },
        "required_documents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "name_te": { "type": "string" },
              "optional": { "type": "boolean" }
            },
            "required": ["name", "name_te", "optional"],
            "additionalProperties": false
          }
        },
        "local_help_locations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "coverage_type": {
          "type": "string",
          "description": "Nature of healthcare coverage (e.g. Cashless Hospitalization, Direct Benefit Transfer, Free Service)"
        },
        "coverage_type_te": {
          "type": "string",
          "description": "Telugu translation of coverage type"
        },
        "benefit_amount": {
          "type": "string",
          "description": "Financial ceiling or quantifiable benefit value"
        },
        "benefit_amount_te": {
          "type": "string",
          "description": "Telugu description of financial ceiling or quantifiable benefit value"
        },
        "target_beneficiary": {
          "type": "string",
          "description": "Primary eligible citizen group / target demographic"
        },
        "target_beneficiary_te": {
          "type": "string",
          "description": "Telugu description of target demographic"
        },
        "application_mode": {
          "type": "string",
          "description": "Primary application channel or access mechanism"
        },
        "application_mode_te": {
          "type": "string",
          "description": "Telugu translation of application mode"
        },
        "processing_time": {
          "type": "string",
          "description": "Expected turnaround or delivery timeline"
        },
        "processing_time_te": {
          "type": "string",
          "description": "Telugu description of processing timeline"
        },
        "facility_type": {
          "type": "string",
          "description": "Types of hospitals or healthcare facilities delivering this scheme"
        },
        "facility_type_te": {
          "type": "string",
          "description": "Telugu description of facility types"
        },
        "validity_period": {
          "type": "string",
          "description": "Coverage validity or entitlement timeframe"
        },
        "validity_period_te": {
          "type": "string",
          "description": "Telugu description of validity period"
        },
        "helpline_numbers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Official toll-free helpline numbers and grievance lines"
        },
        "key_treatments": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Key medical procedures, treatments, or services covered"
        },
        "key_treatments_te": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Key medical procedures, treatments, or services covered in Telugu"
        },
        "exclusions": {
          "type": "string",
          "description": "Services or scenarios not covered by the scheme"
        },
        "exclusions_te": {
          "type": "string",
          "description": "Telugu description of exclusions and coverage boundaries"
        }
      },
      "required": [
        "category",
        "original_complex_text",
        "simplified",
        "telugu",
        "required_documents"
      ],
      "additionalProperties": true
    }
  }
}
