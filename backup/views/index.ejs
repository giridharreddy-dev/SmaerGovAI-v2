<!DOCTYPE html>
<html lang="te">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <meta name="theme-color" content="#176b5b">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="description" content="Andhra Pradesh government health schemes lookup, AI assistant, and document simplification platform.">
    <meta name="csrf-token" content="<%= csrf_token %>">
    <title>SmartGov Health | Andhra Pradesh Schemes</title>
    
    <!-- PWA Manifest & Icons -->
    <link rel="manifest" href="/static/manifest.webmanifest">
    <link rel="icon" type="image/svg+xml" href="/static/icon.svg">
    <!-- Leaflet CSS for Health Map -->
    <link rel="stylesheet" href="/static/leaflet/leaflet.css">
    
    <link rel="stylesheet" href="/static/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Noto+Sans+Telugu:wght@400;600;700;800&display=swap" rel="stylesheet">
</head>
<body <% if (auto_open_scheme) { %>data-auto-open="<%= auto_open_scheme %>"<% } %>>
    <a href="#mainContent" class="skip-link">Skip to main content / ప్రధాన విషయానికి వెళ్లండి</a>
    <div class="app-shell">
        <header class="hero">
            <div class="hero-top">
                <span class="badge" data-i18n="heroBadge">ఆంధ్రప్రదేశ్ ప్రభుత్వం • ప్రజా ఆరోగ్యం</span>
                <span class="hero-sub" data-i18n="heroSub">గ్రామీణ, వయోవృద్ధుల సులభ మార్గదర్శి</span>
            </div>
            <div class="header-controls">
                <div class="lang-toggle-wrap">
                    <span class="lang-label">భాష / Lang:</span>
                    <div class="lang-buttons">
                        <button type="button" class="lang-btn active" id="langTeBtn" data-action="set-lang" data-lang="te" aria-pressed="true">తెలుగు</button>
                        <button type="button" class="lang-btn" id="langEnBtn" data-action="set-lang" data-lang="en" aria-pressed="false">English</button>
                    </div>
                </div>
                <div class="header-right-actions">
                    <button type="button" class="contrast-btn" id="contrastBtn" data-action="toggle-contrast" title="High Contrast Mode / అధిక కాంట్రాస్ట్" aria-label="Toggle high contrast mode">
                        <span class="contrast-icon" aria-hidden="true">🌓</span>
                        <span class="contrast-text" data-i18n="contrastBtn">కాంట్రాస్ట్</span>
                    </button>
                    <button type="button" class="install-app-btn" id="installAppBtn" data-action="install-app" style="display:none;" title="Install App / యాప్ ఇన్‌స్టాల్ చేయండి">
                        <span aria-hidden="true">📲</span>
                        <span data-i18n="installAppBtn">ఇన్‌స్టాల్</span>
                    </button>
                </div>
            </div>
            <h1 data-i18n="appTitle">ఆరోగ్య పథకాల సహాయకం</h1>
            <p data-i18n="appSubtitle">మీకు వర్తించే ఉచిత వైద్యం, మందులు మరియు ప్రభుత్వ పథకాలను సులభంగా తెలుసుకోండి.</p>
        </header>

        <section class="assistant-bar" aria-label="AI Assistant and Map Tools">
            <div class="assistant-bar-inner">
                <button type="button" class="assistant-trigger-btn primary" data-action="open-chat">
                    <span class="assistant-icon" aria-hidden="true">🤖</span>
                    <span class="assistant-text">
                        <strong data-i18n="aiAssistantTitle">AI సహాయకుడిని అడగండి</strong>
                        <small data-i18n="aiAssistantSub">పథకాలపై మీ ప్రశ్నలకు తక్షణ సమాధానాలు</small>
                    </span>
                </button>
                <button type="button" class="assistant-trigger-btn map-btn" data-action="open-map">
                    <span class="assistant-icon" aria-hidden="true">🗺️</span>
                    <span class="assistant-text">
                        <strong data-i18n="mapTitle">సమీప ఆసుపత్రులు & PHC మ్యాప్</strong>
                        <small data-i18n="mapSub">AP వ్యాప్తంగా ఆరోగ్య కేంద్రాలు</small>
                    </span>
                </button>
                <button type="button" class="assistant-trigger-btn emergency-btn" data-action="open-emergency">
                    <span class="assistant-icon" aria-hidden="true">🚨</span>
                    <span class="assistant-text">
                        <strong data-i18n="emergencyTitle">అత్యవసర హెల్ప్‌లైన్లు</strong>
                        <small data-i18n="emergencySub">108 • 104 • 102 ఉచిత నంబర్లు</small>
                    </span>
                </button>
            </div>
        </section>

        <!-- Emergency Helplines Modal -->
        <dialog id="emergencyModal" class="app-dialog emergency-dialog" aria-labelledby="emergencyHeading">
            <div class="dialog-header">
                <h2 id="emergencyHeading">🚨 అత్యవసర హెల్ప్‌లైన్లు (Emergency Helplines)</h2>
                <button type="button" class="dialog-close-btn" data-action="close-emergency" aria-label="Close">✕</button>
            </div>
            <div class="dialog-body">
                <div class="emergency-cards-grid">
                    <a href="tel:108" class="emergency-card red">
                        <span class="emergency-number">108</span>
                        <strong data-i18n="helpline108Title">అత్యవసర అంబులెన్స్</strong>
                        <small data-i18n="helpline108Sub">ఉచిత 24/7 అత్యవసర సర్వీస్</small>
                    </a>
                    <a href="tel:104" class="emergency-card blue">
                        <span class="emergency-number">104</span>
                        <strong data-i18n="helpline104Title">వైద్య సమాచార కేంద్రం</strong>
                        <small data-i18n="helpline104Sub">ఆరోగ్య సలహాలు, పథకాల వివరాలు</small>
                    </a>
                    <a href="tel:102" class="emergency-card green">
                        <span class="emergency-number">102</span>
                        <strong data-i18n="helpline102Title">తల్లీ-బిడ్డ ఎక్స్‌ప్రెస్</strong>
                        <small data-i18n="helpline102Sub">గర్భిణులు & బాలింతల వాహనం</small>
                    </a>
                    <a href="tel:181" class="emergency-card purple">
                        <span class="emergency-number">181</span>
                        <strong data-i18n="helpline181Title">మహిళా హెల్ప్‌లైన్</strong>
                        <small data-i18n="helpline181Sub">మహిళల రక్షణ & సహాయం</small>
                    </a>
                </div>
                <div class="emergency-footer">
                    <p data-i18n="emergencyNote">ఈ నంబర్లన్నీ ఉచితం (Toll-Free). ఏదైనా ఫోన్ నుండి డయల్ చేయవచ్చు.</p>
                </div>
            </div>
        </dialog>

        <!-- Chat Modal -->
        <dialog id="chatModal" class="app-dialog chat-dialog" aria-labelledby="chatHeading">
            <div class="dialog-header">
                <div class="chat-header-title">
                    <span class="chat-header-avatar" aria-hidden="true">🤖</span>
                    <div>
                        <h2 id="chatHeading" data-i18n="chatModalTitle">SmartGovAI ఆరోగ్య సహాయకుడు</h2>
                        <small data-i18n="chatModalSub">ఆంధ్రప్రదేశ్ ఆరోగ్య పథకాల సమాచారం</small>
                    </div>
                </div>
                <button type="button" class="dialog-close-btn" data-action="close-chat" aria-label="Close">✕</button>
            </div>
            <div class="chat-messages" id="chatMessages" role="log" aria-live="polite">
                <div class="chat-bubble bot intro">
                    <p data-i18n="chatIntroMsg">నమస్కారం! నేను SmartGovAI ఆరోగ్య సహాయకుడిని. ఆరోగ్యశ్రీ, గర్భిణుల పథకాలు, ఉచిత మందులు లేదా ఆసుపత్రి చికిత్స గురించి మీ ప్రశ్నను అడగండి.</p>
                </div>
            </div>
            <div class="chat-quick-questions">
                <button type="button" class="quick-q-btn" data-action="ask-quick" data-q="ఆరోగ్యశ్రీకి ఎవరు అర్హులు?">ఆరోగ్యశ్రీ అర్హత?</button>
                <button type="button" class="quick-q-btn" data-action="ask-quick" data-q="గర్భిణులకు ఏ పథకాలు ఉన్నాయి?">గర్భిణుల పథకాలు?</button>
                <button type="button" class="quick-q-btn" data-action="ask-quick" data-q="ఉచిత మందులు ఎక్కడ దొరుకుతాయి?">ఉచిత మందులు?</button>
                <button type="button" class="quick-q-btn" data-action="ask-quick" data-q="పిల్లల టీకాల పథకం ఏది?">పిల్లల టీకాలు?</button>
            </div>
            <form class="chat-input-bar" id="chatForm">
                <input type="text" id="chatInput" placeholder="మీ ప్రశ్నను ఇక్కడ టైప్ చేయండి..." data-i18n-placeholder="chatInputPlaceholder" autocomplete="off" maxlength="300" required>
                <button type="submit" class="chat-send-btn" id="chatSendBtn" aria-label="Send message">
                    <span aria-hidden="true">➤</span>
                </button>
            </form>
        </dialog>

        <!-- Symptom / Need Finder Panel -->
        <section class="symptom-finder-section" aria-label="Need Finder">
            <details class="symptom-finder-details">
                <summary data-i18n="symptomFinderSummary">🎯 మీ అవసరం / సమస్య ఆధారంగా పథకం కనుగొనండి</summary>
                <div class="symptom-chips-grid">
                    <button type="button" class="symptom-chip" data-action="filter-keyword" data-kw="hospital">🏥 ఆసుపత్రిలో చేరడం / శస్త్రచికిత్స</button>
                    <button type="button" class="symptom-chip" data-action="filter-keyword" data-kw="pregnancy">🤰 గర్భం / ప్రసవం / బాలింత</button>
                    <button type="button" class="symptom-chip" data-action="filter-keyword" data-kw="children">👶 పిల్లల ఆరోగ్యం / టీకాలు</button>
                    <button type="button" class="symptom-chip" data-action="filter-keyword" data-kw="elderly">👴 వృద్ధాప్య చికిత్స / సంరక్షణ</button>
                    <button type="button" class="symptom-chip" data-action="filter-keyword" data-kw="medicines">💊 ఉచిత మందులు / క్లినిక్</button>
                    <button type="button" class="symptom-chip" data-action="filter-keyword" data-kw="emergency">🚑 అత్యవసర రవాణా (108/104)</button>
                    <button type="button" class="symptom-chip" data-action="filter-keyword" data-kw="kidney">🧬 డయాలసిస్ / దీర్ఘకాలిక వ్యాధి</button>
                    <button type="button" class="symptom-chip" data-action="filter-keyword" data-kw="tb">🫁 క్షయ (TB) చికిత్స & పోషణ</button>
                </div>
            </details>
        </section>

        <section id="mainContent" class="search-panel" aria-label="Search and filter schemes">
            <div class="search-wrap">
                <label for="searchInput" class="sr-only" data-i18n="searchPlaceholder">పథకం పేరు, వ్యాధి లేదా కీవర్డ్ ద్వారా వెతకండి...</label>
                <input
                    id="searchInput"
                    type="text"
                    placeholder="పథకం పేరు, వ్యాధి లేదా కీవర్డ్ ద్వారా వెతకండి..."
                    data-i18n-placeholder="searchPlaceholder"
                    autocomplete="off"
                    maxlength="100"
                >
                <button
                    id="voiceBtn"
                    class="voice-btn"
                    type="button"
                    title="వాయిస్ ద్వారా వెతకండి"
                    aria-label="వాయిస్ ద్వారా వెతకండి"
                >
                    🎤
                </button>
            </div>
            <div id="voiceStatus" class="voice-status" aria-live="polite"></div>

            <div class="filter-row">
                <span class="filter-label" data-i18n="filterLabel">ఫిల్టర్:</span>
                <div class="filter-buttons">
                    <button type="button" class="filter-btn active" data-action="set-filter" data-filter="all" data-i18n="filterAll" aria-pressed="true">అన్నీ</button>
                    <button type="button" class="filter-btn" data-action="set-filter" data-filter="ap" data-i18n="filterAP" aria-pressed="false">ఆంధ్రప్రదేశ్</button>
                    <button type="button" class="filter-btn" data-action="set-filter" data-filter="national" data-i18n="filterNational" aria-pressed="false">జాతీయ</button>
                    <button type="button" class="filter-btn favorites-btn" data-action="set-filter" data-filter="favorites" data-i18n="filterFavorites" aria-pressed="false">★ ఇష్టమైనవి</button>
                </div>
            </div>

            <!-- Schemes Cards Grid View -->
            <div class="schemes-grid-section">
                <div class="grid-header">
                    <h2 data-i18n="availableSchemesTitle">అందుబాటులో ఉన్న ఆరోగ్య పథకాలు</h2>
                    <span id="schemeCountBadge" class="count-badge">0</span>
                </div>
                <div id="schemesGrid" class="schemes-grid" role="region" aria-label="Schemes Grid">
                    <!-- Dynamic Scheme Cards Injected Here -->
                </div>
            </div>

            <details class="staff-panel">
                <summary data-i18n="staffToolsSummary">సచివాలయం / ఆరోగ్య సిబ్బంది సాధనాలు</summary>
                <div class="staff-body">
                    <div class="field">
                        <label for="schemeSelect" data-i18n="selectSchemeFromList">జాబితా నుండి పథకం</label>
                        <select id="schemeSelect">
                            <option value="">-- ఎంచుకోండి --</option>
                            <% Object.keys(schemes).sort().forEach(function(scheme) { %>
                            <option value="<%= scheme %>"><%= schemes[scheme].telugu_name %> | <%= scheme %></option>
                            <% }); %>
                        </select>
                    </div>
                    <button id="dropdownBtn" class="primary-btn" type="button" data-i18n="showDetailsBtn">వివరాలు చూపించు</button>
                    <div class="field">
                        <label for="pdfUpload" data-i18n="pdfDocumentLabel">PDF పత్రం</label>
                        <input type="file" id="pdfUpload" accept="application/pdf">
                    </div>
                    <button id="uploadBtn" class="secondary-btn" type="button" data-i18n="pdfSimplifyBtn">PDF ను సరళీకరించు</button>
                    <div class="privacy-warning" style="margin: 12px 0 0; font-size: 0.85rem;" data-i18n="privacyWarning">
                        🔒 గోప్యతా నోటీసు: ఆధార్ కార్డు నంబర్లు లేదా వ్యక్తిగత వైద్య పత్రాలను ఇక్కడ అప్‌లోడ్ చేయవద్దు.
                    </div>
                    <label class="consent-label" style="display:flex;align-items:flex-start;gap:8px;margin:12px 0 0;font-size:0.85rem;cursor:pointer;">
                        <input type="checkbox" id="pdfConsent" style="margin-top:3px;">
                        <span data-i18n="pdfConsent">నేను వ్యక్తిగత డేటాను అప్‌లోడ్ చేయడం లేదని ధృవీకరిస్తున్నాను (I consent to document processing without PII)</span>
                    </label>
                </div>
            </details>
        </section>

        <aside id="resultArea" class="result-panel" aria-live="polite">
            <div class="empty-state">
                <div>
                    <strong data-i18n="aboutSchemeTitle">పథకం ఎంచుకోండి</strong>
                    <span data-i18n="emptyResultsMsg">వివరాలు ఇక్కడ కనిపిస్తాయి.</span>
                </div>
            </div>
        </aside>
    </div>

<!-- Fullscreen Map Overlay Container -->
<div id="fullScreenMapContainer" class="fullscreen-map-overlay" style="display:none;">
    <div class="map-overlay-header">
        <h2>🗺️ <span data-i18n="mapOverlayTitle">ఆంధ్రప్రదేశ్ ఆరోగ్య కేంద్రాలు & PHC మ్యాప్</span></h2>
        <button type="button" class="dialog-close-btn" data-action="close-map" aria-label="Close Map">✕</button>
    </div>
    <div class="map-controls-bar">
        <div style="display: flex; flex-wrap: wrap; gap: 8px;">
            <div style="flex: 1 1 45%;">
                <label for="typeSelectFull" style="font-size: 0.85rem;" data-i18n="mapType">రకం:</label>
                <select id="typeSelectFull" class="map-select" style="width:100%;">
                    <option value="all">అన్నీ</option>
                    <option value="PHC">PHC</option>
                    <option value="CHC">CHC</option>
                    <option value="Hospital">Hospital</option>
                    <option value="none">కేవలం మ్యాప్</option>
                </select>
            </div>
            <div style="flex: 1 1 45%;">
                <label for="districtSelectFull" style="font-size: 0.85rem;" data-i18n="mapDistrict">జిల్లా:</label>
                <select id="districtSelectFull" class="map-select" style="width:100%;"><option value="">-- ఎంచుకోండి --</option></select>
            </div>
            <div style="flex: 1 1 45%;">
                <label for="mandalSelectFull" style="font-size: 0.85rem;" data-i18n="mapMandal">మండలం:</label>
                <select id="mandalSelectFull" class="map-select" style="width:100%;" disabled><option value="">-- ఎంచుకోండి --</option></select>
            </div>
            <div style="flex: 1 1 45%;">
                <label for="villageSelectFull" style="font-size: 0.85rem;" data-i18n="mapVillage">గ్రామం:</label>
                <select id="villageSelectFull" class="map-select" style="width:100%;" disabled><option value="">-- ఎంచుకోండి --</option></select>
            </div>
        </div>
        <div id="searchResultsFull" style="margin-top: 8px; font-weight: bold; color: var(--primary);"></div>
    </div>
    <div id="fullScreenMap" class="map-container"></div>
</div>

<!-- Scripts Loading -->
<script src="/static/leaflet/leaflet.js"></script>
<script src="/static/i18n.js"></script>
<script src="/static/enhanced-features.js"></script>

<script nonce="<%= csp_nonce %>">
    const schemesCatalog = <%- JSON.stringify(schemes) %>;
    window.schemesCatalog = schemesCatalog;
    const schemeNames = <%- JSON.stringify(scheme_names) %>;
    const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
    const iconMap = {
        hospital: '🏥',
        ambulance: '🚑',
        'mobile-clinic': '🩺',
        shield: '🛡',
        clinic: '➕',
        'phone-doctor': '📱',
        diet: '🥗',
        eye: '👁️',
        baby: '👶',
        kidney: '🧬',
        nutrition: '🥣'
    };

    let activeFilter = 'all';
    let currentRequestId = null;
    let currentSchemeName = null;
    let currentSchemeData = null;
    let deferredInstallPrompt = null;

    // Pre-compute lowercase search haystacks once on load to optimize performance
    const searchHaystacks = {};
    for (const name of schemeNames) {
        searchHaystacks[name] = haystackFor(name, schemesCatalog[name]);
    }

    function haystackFor(name, data) {
        return [
            name,
            data.telugu_name || '',
            data.category || '',
            data.level || '',
            data.english_description || '',
            data.telugu_description || '',
            ...(data.keywords || [])
        ].join(' ').toLowerCase();
    }

    function matchesFilter(data) {
        if (activeFilter === 'all') return true;
        if (activeFilter === 'ap') return data.level === 'Andhra Pradesh';
        return data.level === 'National';
    }

    let lastQuery = '';
    let lastFilter = null;
    let lastLang = null;

    function renderSchemeCards(force = false) {
        const rawQuery = document.getElementById('searchInput').value.trim();
        const query = rawQuery.toLowerCase();
        const grid = document.getElementById('schemesGrid');
        const countBadge = document.getElementById('schemeCountBadge');
        if (!grid) return;

        const currentLang = window.getLang ? window.getLang() : 'te';

        if (!force && query === lastQuery && activeFilter === lastFilter && currentLang === lastLang) {
            return;
        }
        lastQuery = query;
        lastFilter = activeFilter;
        lastLang = currentLang;

        let filtered = schemeNames.filter(name => {
            const data = schemesCatalog[name];
            if (!data) return false;

            if (activeFilter === 'favorites') {
                return window.SmartGovUX ? window.SmartGovUX.isFavorite(name) : false;
            }

            if (!matchesFilter(data)) return false;
            if (!query) return true;

            return searchHaystacks[name].includes(query);
        });

        if (countBadge) {
            countBadge.textContent = filtered.length;
        }

        if (filtered.length === 0) {
            const emptyMsg = activeFilter === 'favorites'
                ? (window.t ? window.t('noFavoritesMsg') : 'ఇష్టమైన పథకాలు ఏవీ లేవు. పథకం కార్డుపై ఉన్న ★ నక్షత్రాన్ని నొక్కి ఇష్టమైనదిగా చేర్చుకోండి.')
                : (window.t ? window.t('noSchemesFound') : 'ఎలాంటి పథకాలు దొరకలేదు.');
            grid.innerHTML = `<div class="grid-empty-msg">${window.escapeHtml(emptyMsg)}</div>`;
            return;
        }

        const isEn = currentLang === 'en';

        grid.innerHTML = filtered.map(name => {
            const data = schemesCatalog[name];
            const levelClass = data.level === 'Andhra Pradesh' ? 'level-ap' : 'level-national';
            const levelLabel = window.SmartGovI18n ? window.SmartGovI18n.translateLevel(data.level) : (data.level === 'Andhra Pradesh' ? 'AP' : 'National');
            const categoryLabel = window.SmartGovI18n ? window.SmartGovI18n.translateCategory(data.category) : (data.category || '');
            const isFavorite = window.SmartGovUX ? window.SmartGovUX.isFavorite(name) : false;
            const primaryTitle = isEn ? name : (data.telugu_name || name);
            const secondaryTitle = isEn ? categoryLabel : name;
            const favTitle = window.t ? window.t('favoriteBtnTitle') : 'Favorite';

            return `
                <button class="scheme-card" type="button" data-action="open-scheme" data-scheme="${window.escapeHtml(name)}">
                    <div class="favorite-btn ${isFavorite ? 'active' : ''}" data-scheme="${window.escapeHtml(name)}" title="${favTitle}" aria-label="Toggle favorite" tabindex="0">
                        ${isFavorite ? '★' : '☆'}
                    </div>
                    <span class="card-top">
                        <span class="card-icon" aria-hidden="true">${iconMap[data.icon] || '➕'}</span>
                        <span class="level-badge ${levelClass}">${levelLabel}</span>
                    </span>
                    <h2>${window.escapeHtml(primaryTitle)}</h2>
                    <p>${window.escapeHtml(secondaryTitle)}</p>
                    <span class="category">${window.escapeHtml(categoryLabel)}</span>
                </button>
            `;
        }).join('');
    }

