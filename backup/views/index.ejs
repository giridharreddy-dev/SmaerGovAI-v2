    async function handleUpload() {
        const file = document.getElementById('pdfUpload').files[0];
        if (!file) {
            showError(window.t ? window.t('selectPdfError') : 'దయచేసి PDF ఫైల్ ఎంచుకోండి.');
            return;
        }

        const consentCheckbox = document.getElementById('pdfConsent');
        if (!consentCheckbox || !consentCheckbox.checked) {
            showError(window.t ? window.t('pdfConsent') : 'దయచేసి PDF అప్‌లోడ్ చేయడానికి ముందు గోప్యతా అంగీకారం చెక్‌బాక్స్ ను టిక్ చేయండి.');
            return;
        }

        showLoading(window.t ? window.t('loadingPdf') : 'PDF సరళీకరిస్తున్నాం...');
        const resultArea = document.getElementById('resultArea');
        const stages = [
            window.t ? window.t('pdfProgressRead') : "పత్రం చదువుతున్నాం... (Reading document...)",
            window.t ? window.t('pdfProgressExtract') : "ముఖ్యమైన వివరాలు వెతుకుతున్నాం... (Extracting details...)",
            window.t ? window.t('pdfProgressTranslate') : "తెలుగులోకి మారుస్తున్నాం... (Translating to Telugu...)",
            window.t ? window.t('pdfProgressAudio') : "ఆడియో తయారుచేస్తున్నాం... (Preparing audio...)"
        ];
        let stageIndex = 0;
        const progressInterval = setInterval(() => {
            const loader = resultArea.querySelector('.loading');
            if (loader && stageIndex < stages.length) {
                loader.textContent = stages[stageIndex];
                stageIndex++;
            }
        }, 2000);

        const formData = new FormData();
        formData.append('document', file);
        formData.append('consent', 'true');
        try {
            const data = await safeFetch("/simplify", {
                method: 'POST',
                headers: {
                    'X-CSRFToken': csrfToken
                },
                body: formData
            });
            clearInterval(progressInterval);
            displayResult(data);
        } catch (error) {
            clearInterval(progressInterval);
            showError(window.t ? window.t('networkError', { error: error.message }) : `PDF లోపం: ${error.message}`);
        }
    }

    function bestVoiceMatch(spokenText) {
        const spoken = spokenText.toLowerCase().trim();
        if (!spoken) return null;

        let bestName = null;
        let bestScore = 0;
        for (const name of schemeNames) {
            const data = schemesCatalog[name];
            const words = [
                name,
                data.telugu_name,
                data.category,
                ...(data.keywords || [])
            ].map(value => String(value).toLowerCase());

            let score = 0;
            for (const word of words) {
                if (!word) continue;
                if (spoken.includes(word) || word.includes(spoken)) score += 3;
                const pieces = word.split(/\s+/).filter(Boolean);
                for (const piece of pieces) {
                    if (piece.length > 2 && spoken.includes(piece)) score += 1;
                }
            }

            if (score > bestScore) {
                bestScore = score;
                bestName = name;
            }
        }
        return bestScore > 0 ? bestName : null;
    }

    let recognition = null;
    if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
        const SpeechRecognition = window.webkitSpeechRecognition || window.SpeechRecognition;
        recognition = new SpeechRecognition();
        recognition.lang = window.getLang && window.getLang() === 'en' ? 'en-IN' : 'te-IN';
        recognition.continuous = false;
        recognition.interimResults = false;
    }

    function setupVoice() {
        const voiceBtn = document.getElementById('voiceBtn');
        const status = document.getElementById('voiceStatus');
        if (!voiceBtn || !status) return;

        function updateVoiceTooltips() {
            const titleText = window.t ? window.t('voiceBtnTitle') : 'వాయిస్ ద్వారా వెతకండి';
            const ariaText = window.t ? window.t('voiceBtnAria') : 'వాయిస్ ద్వారా వెతకండి';
            voiceBtn.setAttribute('title', titleText);
            voiceBtn.setAttribute('aria-label', ariaText);
        }
        updateVoiceTooltips();

        if (!recognition) {
            voiceBtn.addEventListener('click', () => {
                status.textContent = window.t ? window.t('voiceNotSupported') : (window.getLang && window.getLang() === 'en' ? 'Voice recognition not supported.' : 'ఈ బ్రౌజర్ మైక్ గుర్తింపుకు మద్దతు ఇవ్వదు.');
            });
            return;
        }

        voiceBtn.addEventListener('click', () => {
            status.textContent = window.t ? window.t('voiceListening') : 'వింటున్నాం... మాట్లాడండి';
            voiceBtn.disabled = true;
            try {
                if (recognition) {
                    recognition.lang = window.getLang && window.getLang() === 'en' ? 'en-IN' : 'te-IN';
                }
                recognition.start();
            } catch (_error) {
                voiceBtn.disabled = false;
                status.textContent = window.t ? window.t('voiceStartError') : 'మైక్ ప్రారంభం కాలేదు. మళ్లీ ప్రయత్నించండి.';
            }
        });

        recognition.onresult = event => {
            const spoken = event.results[0][0].transcript;
            const match = bestVoiceMatch(spoken);
            if (match) {
                status.textContent = `${spoken} -> ${match}`;
                fetchScheme(match);
            } else {
                status.textContent = `${spoken}`;
            }
        };

        recognition.onerror = event => {
            const errCode = event.error || 'unknown';
            const localizedMsg = window.SmartGovI18n ? window.SmartGovI18n.getLocalizedMicError(errCode) : (window.getLang && window.getLang() === 'en' ? `Microphone error: ${errCode}` : `మైక్ లోపం: ${errCode}`);
            status.textContent = localizedMsg;
        };

        recognition.onend = () => {
            voiceBtn.disabled = false;
        };
    }

    function setupInstallPrompt() {
        const installBtn = document.getElementById('installAppBtn');
        if (!installBtn) return;

        window.addEventListener('beforeinstallprompt', e => {
            e.preventDefault();
            deferredInstallPrompt = e;
            installBtn.style.display = 'inline-flex';
        });

        installBtn.addEventListener('click', async () => {
            if (!deferredInstallPrompt) return;
            deferredInstallPrompt.prompt();
            const { outcome } = await deferredInstallPrompt.userChoice;
            if (outcome === 'accepted') {
                installBtn.style.display = 'none';
            }
            deferredInstallPrompt = null;
        });

        window.addEventListener('appinstalled', () => {
            installBtn.style.display = 'none';
            deferredInstallPrompt = null;
        });
    }

    // Event Delegation Handler
    document.addEventListener('click', e => {
        const actionTarget = e.target.closest('[data-action]');
        if (!actionTarget) return;

        const action = actionTarget.dataset.action;

        if (action === 'open-scheme') {
            if (e.target.closest('.favorite-btn')) return;
            const scheme = actionTarget.dataset.scheme;
            if (scheme) fetchScheme(scheme);
        } else if (action === 'set-filter') {
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.classList.remove('active');
                btn.setAttribute('aria-pressed', 'false');
            });
            actionTarget.classList.add('active');
            actionTarget.setAttribute('aria-pressed', 'true');
            activeFilter = actionTarget.dataset.filter || 'all';
            renderSchemeCards(true);
        } else if (action === 'set-lang') {
            const lang = actionTarget.dataset.lang || 'te';
            if (window.SmartGovI18n) {
                window.SmartGovI18n.setLanguage(lang);
                populateSchemeDropdown(lang);
                renderSchemeCards(true);
                if (currentSchemeData) {
                    displayResult(currentSchemeData);
                }
            }
        } else if (action === 'toggle-contrast') {
            if (window.SmartGovUX) {
                window.SmartGovUX.toggleContrast();
            }
        } else if (action === 'open-chat') {
            const dialog = document.getElementById('chatModal');
            if (dialog) dialog.showModal();
        } else if (action === 'close-chat') {
            const dialog = document.getElementById('chatModal');
            if (dialog) dialog.close();
        } else if (action === 'open-map') {
            const container = document.getElementById('fullScreenMapContainer');
            if (container) {
                container.style.display = 'flex';
                if (window.SmartGovEnhanced?.initMap) {
                    window.SmartGovEnhanced.initMap();
                }
            }
        } else if (action === 'close-map') {
            const container = document.getElementById('fullScreenMapContainer');
            if (container) container.style.display = 'none';
        } else if (action === 'open-emergency') {
            const dialog = document.getElementById('emergencyModal');
            if (dialog) dialog.showModal();
        } else if (action === 'close-emergency') {
            const dialog = document.getElementById('emergencyModal');
            if (dialog) dialog.close();
        } else if (action === 'filter-keyword') {
            const kw = actionTarget.dataset.kw;
            const input = document.getElementById('searchInput');
            if (input && kw) {
                input.value = kw;
                renderSchemeCards(true);
                document.getElementById('mainContent').scrollIntoView({ behavior: 'smooth' });
            }
        } else if (action === 'start-guided-mode') {
            if (window.SmartGovEnhanced?.startGuidedMode && currentSchemeData) {
                window.SmartGovEnhanced.startGuidedMode(currentSchemeData);
            }
        } else if (action === 'print-qr-card') {
            const sName = actionTarget.dataset.scheme;
            const slug = actionTarget.dataset.slug;
            const sData = schemesCatalog[sName];
            if (window.SmartGovEnhanced?.printSchemeQRCard) {
                window.SmartGovEnhanced.printSchemeQRCard(sName, slug, sData);
            }
        } else if (action === 'ask-quick') {
            const q = actionTarget.dataset.q;
            const input = document.getElementById('chatInput');
            if (input && q) {
                input.value = q;
                const form = document.getElementById('chatForm');
                if (form) form.dispatchEvent(new Event('submit', { cancelable: true }));
            }
        }
    });

    // Handle Search Input
    let searchDebounce = null;
    document.getElementById('searchInput').addEventListener('input', () => {
        clearTimeout(searchDebounce);
        searchDebounce = setTimeout(() => {
            renderSchemeCards();
        }, 150);
    });

    // Handle Dropdown and Upload Buttons
    document.getElementById('dropdownBtn')?.addEventListener('click', () => {
        const val = document.getElementById('schemeSelect').value;
        if (val) fetchScheme(val);
    });

    document.getElementById('uploadBtn')?.addEventListener('click', handleUpload);

    // Chat form submit
    document.getElementById('chatForm')?.addEventListener('submit', async e => {
        e.preventDefault();
        const input = document.getElementById('chatInput');
        const text = input.value.trim();
        if (!text) return;

        const messages = document.getElementById('chatMessages');
        const userMsg = document.createElement('div');
        userMsg.className = 'chat-bubble user';
        userMsg.textContent = text;
        messages.appendChild(userMsg);
        input.value = '';

        const typing = document.createElement('div');
        typing.className = 'chat-bubble bot typing';
        typing.textContent = '...';
        messages.appendChild(typing);
        messages.scrollTop = messages.scrollHeight;

        try {
            const activeLang = window.getLang ? window.getLang() : 'te';
            const data = await safeFetch('/chat', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRFToken': csrfToken
                },
                body: JSON.stringify({ question: text, lang: activeLang })
            });

            typing.remove();
            const botMsg = document.createElement('div');
            botMsg.className = 'chat-bubble bot';
            botMsg.innerHTML = window.escapeHtml(data.response || data.error || 'క్షమించండి, సమాధానం దొరకలేదు.').replace(/\n/g, '<br>');
            messages.appendChild(botMsg);
        } catch (err) {
            typing.remove();
            const botMsg = document.createElement('div');
            botMsg.className = 'chat-bubble bot';
            botMsg.textContent = 'నెట్‌వర్క్ లోపం. దయచేసి మళ్ళీ ప్రయత్నించండి.';
            messages.appendChild(botMsg);
        }
        messages.scrollTop = messages.scrollHeight;
    });

    function restoreEligibilityAnswers() {
        document.querySelectorAll('.question-item').forEach(item => {
            const firstBtn = item.querySelector('.yes-no-btn');
            if (!firstBtn) return;
            const idx = firstBtn.dataset.idx;
            const saved = (currentSchemeName ? localStorage.getItem(`eligibility_${currentSchemeName}_q${idx}`) : null) ||
                          localStorage.getItem(`eligibility_q${idx}`);
            if (saved) {
                const buttons = item.querySelectorAll('.yes-no-btn');
                buttons.forEach(btn => {
                    btn.classList.remove('yes', 'no');
                    if ((saved === 'yes' && (btn.textContent.includes('అవును') || btn.textContent.includes('Yes'))) ||
                        (saved === 'no' && (btn.textContent.includes('కాదు') || btn.textContent.includes('No')))) {
                        btn.classList.add(saved);
                    }
                });
            }
        });
    }

    function restoreDocumentChecks() {
        if (currentSchemeName) {
            document.querySelectorAll('.checklist-item input[type="checkbox"]').forEach((checkbox, idx) => {
                const saved = localStorage.getItem(`doc_check_${currentSchemeName}_${idx}`);
                if (saved === 'true') checkbox.checked = true;
            });
        }
    }

    // Auto-open scheme from URL or parameter
    const autoOpen = document.body.dataset.autoOpen;
    if (autoOpen && schemesCatalog[autoOpen]) {
        fetchScheme(autoOpen);
    }

    // Initialize initial language states on startup
    if (window.SmartGovI18n) {
        window.SmartGovI18n.applyStaticTranslations();
        const activeLang = window.getLang ? window.getLang() : 'te';
        const teBtn = document.getElementById('langTeBtn');
        const enBtn = document.getElementById('langEnBtn');
        if (teBtn && enBtn) {
            if (activeLang === 'te') {
                teBtn.classList.add('active');
                teBtn.setAttribute('aria-pressed', 'true');
                enBtn.classList.remove('active');
                enBtn.setAttribute('aria-pressed', 'false');
            } else {
                enBtn.classList.add('active');
                enBtn.setAttribute('aria-pressed', 'true');
                teBtn.classList.remove('active');
                teBtn.setAttribute('aria-pressed', 'false');
            }
        }
    }

    populateSchemeDropdown();
    renderSchemeCards();
    setupVoice();
    setupInstallPrompt();

    if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register("/static/service-worker.js")
            .then(reg => {
                if (reg.active) {
                    reg.active.postMessage({ type: 'CACHE_ALL_AUDIO' });
                }
            })
            .catch(() => {});
    }

    window.addEventListener('load', () => {
        setTimeout(() => {
            restoreEligibilityAnswers();
            restoreDocumentChecks();
        }, 300);
    });
</script>
</body>
</html>
