    async function handleUpload() {
        const isEn = (window.getLang ? window.getLang() : 'te') === 'en';
        if (!navigator.onLine) {
            const offlineMsg = isEn 
                ? '🌐 Internet Connection Required: AI document simplification requires an active network connection. Other scheme details and guides work offline.' 
                : '🌐 ఇంటర్నెట్ కనెక్షన్ అవసరం: కొత్త PDF / ఇమేజ్ పత్రాలను AI ద్వారా విశ్లేషించడానికి ఇంటర్నెట్ కనెక్షన్ అవసరం. మిగతా అన్ని పథకాల వివరాలు, ఆడియో మరియు అర్హత పరీక్షలు ఆఫ్‌లైన్‌లో పూర్తిగా పనిచేస్తాయి.';
            if (window.showToast) {
                window.showToast(offlineMsg, 'warning');
            } else {
                alert(offlineMsg);
            }
            return;
        }

        const fileInput = document.getElementById('pdfUpload');
        const file = fileInput?.files?.[0];
        if (!file) {
            const selectMsg = isEn 
                ? '⚠️ Please select a PDF or image file first.' 
                : '⚠️ దయచేసి ముందుగా PDF లేదా ఇమేజ్ ఫైల్‌ను ఎంచుకోండి.';

            // Highlight the file input area smoothly without touching or clearing resultArea
            const inputContainer = fileInput?.closest('.field') || fileInput?.parentElement;
            if (inputContainer) {
                inputContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });
                inputContainer.style.transition = 'all 0.3s ease';
                inputContainer.style.outline = '2px dashed #2563eb';
                inputContainer.style.borderRadius = '8px';
                inputContainer.style.background = '#eff6ff';
                setTimeout(() => {
                    inputContainer.style.outline = 'none';
                    inputContainer.style.background = 'transparent';
                }, 3500);
            }

            // Focus and pop up the native file selector dialog so the user can immediately choose a file
            if (fileInput) {
                try {
                    fileInput.focus();
                    fileInput.click();
                } catch (err) {}
            }

            // Show friendly notification popup / toast
            if (window.showToast) {
                window.showToast(selectMsg, 'warning');
            } else {
                alert(selectMsg);
            }
            return;
        }

        const MAX_FILE_SIZE = 20 * 1024 * 1024;
        if (file.size > MAX_FILE_SIZE) {
            const sizeMsg = isEn 
                ? '⚠️ File size exceeds 20MB limit. Please select a document under 20MB.' 
                : '⚠️ ఫైల్ పరిమాణం 20MB కంటే ఎక్కువగా ఉంది. దయచేసి 20MB లోపు ఉన్న PDF లేదా ఇమేజ్ ఫైల్‌ను ఎంచుకోండి.';
            if (window.showToast) {
                window.showToast(sizeMsg, 'error');
            } else {
                alert(sizeMsg);
            }
            return;
        }

        const consentCheckbox = document.getElementById('pdfConsent');
        if (!consentCheckbox || !consentCheckbox.checked) {
            const consentContainer = consentCheckbox ? (consentCheckbox.closest('label') || consentCheckbox.parentElement) : null;
            if (consentContainer) {
                consentContainer.scrollIntoView({ behavior: 'smooth', block: 'center' });
                consentContainer.style.transition = 'all 0.3s ease';
                consentContainer.style.outline = '2px dashed #dc2626';
                consentContainer.style.borderRadius = '8px';
                consentContainer.style.padding = '8px';
                consentContainer.style.background = '#fef2f2';
                setTimeout(() => {
                    consentContainer.style.outline = 'none';
                    consentContainer.style.background = 'transparent';
                    consentContainer.style.padding = '0';
                }, 4000);
            }
            if (consentCheckbox) consentCheckbox.focus();

            const consentMsg = isEn 
                ? '⚠️ Please check "I confirm this document contains no personal data / PII and consent to processing" before uploading.' 
                : '⚠️ దయచేసి పత్రం అప్‌లోడ్ చేయడానికి ముందు గోప్యతా అంగీకారం చెక్‌బాక్స్ (Consent) ను టిక్ చేయండి.';
            if (window.showToast) {
                window.showToast(consentMsg, 'warning');
            } else {
                alert(consentMsg);
            }
            return;
        }

        const isImageFile = file.type.startsWith('image/');
        const controller = startDocumentIngestionUI(file, isImageFile);

        const resultArea = document.getElementById('resultArea');
        if (resultArea) {
            resultArea.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        const formData = new FormData();
        formData.append('document', file);
        formData.append('consent', 'true');

        try {
            const response = await fetch("/simplify-stream", {
                method: 'POST',
                headers: {
                    'X-CSRFToken': csrfToken
                },
                body: formData
            });

            if (!response.ok) {
                const errData = await response.json().catch(() => ({}));
                const isEn = (window.getLang ? window.getLang() : 'te') === 'en';
                const errMsg = isEn 
                    ? (errData?.error_en || errData?.message_en || errData?.rejection_reason_en || errData?.error || 'Uploaded PDF is not related to government healthcare schemes.')
                    : (errData?.error || errData?.message || errData?.rejection_reason_te || 'అప్‌లోడ్ చేసిన PDF పత్రం ప్రభుత్వ ఆరోగ్య లేదా సంక్షేమ పథకాలకు సంబంధించినది కాదు.');
                if (errData?.is_not_govt_scheme || response.status === 400) {
                    controller.nonScheme(errMsg);
                } else {
                    controller.error(errMsg);
                }
                return;
            }

            const reader = response.body.getReader();
            const decoder = new TextDecoder('utf-8');
            let buffer = '';
            let finalResultData = null;

            while (true) {
                const { done, value } = await reader.read();
                if (done) break;

                buffer += decoder.decode(value, { stream: true });
                const blocks = buffer.split('\n\n');
                buffer = blocks.pop() || '';

                for (const block of blocks) {
                    if (!block.trim()) continue;
                    let eventType = 'message';
                    let eventDataStr = '';

                    for (const line of block.split('\n')) {
                        if (line.startsWith('event: ')) {
                            eventType = line.replace('event: ', '').trim();
                        } else if (line.startsWith('data: ')) {
                            eventDataStr += line.replace('data: ', '').trim();
                        }
                    }

                    if (eventDataStr) {
                        try {
                            const parsedData = JSON.parse(eventDataStr);
                            if (eventType === 'progress') {
                                controller.update(parsedData);
                            } else if (eventType === 'result') {
                                finalResultData = parsedData;
                            } else if (eventType === 'error' || parsedData.status === 'rejected' || parsedData.is_not_govt_scheme) {
                                const isEn = (window.getLang ? window.getLang() : 'te') === 'en';
                                const errMsg = isEn 
                                    ? (parsedData.error_en || parsedData.message_en || parsedData.rejection_reason_en || parsedData.error || 'Uploaded PDF is not related to government healthcare schemes.') 
                                    : (parsedData.error || parsedData.message || parsedData.rejection_reason_te || 'అప్‌లోడ్ చేసిన PDF పత్రం ప్రభుత్వ ఆరోగ్య లేదా సంక్షేమ పథకాలకు సంబంధించినది కాదు.');
                                if (parsedData.is_not_govt_scheme) {
                                    controller.nonScheme(errMsg);
                                } else {
                                    controller.error(errMsg);
                                }
                                return;
                            }
                        } catch (e) {
                            console.warn('SSE Chunk parse notice:', e);
                        }
                    }
                }
            }

            if (finalResultData) {
                controller.finish();
                setTimeout(() => {
                    displayResult(finalResultData);
                    if (resultArea) {
                        resultArea.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }
                }, 300);
            } else {
                controller.error((window.getLang ? window.getLang() : 'te') === 'en' ? 'Document analysis yielded no result.' : 'పత్రం విశ్లేషణ ఫలితం పొందడంలో విఫలమైంది.');
            }
        } catch (error) {
            const friendlyErr = (window.getLang ? window.getLang() : 'te') === 'en'
                ? 'Network connection issue while analyzing document stream. Please verify your connection.'
                : 'పత్రం విశ్లేషణలో నెట్‌వర్క్ లోపం ఏర్పడింది. దయచేసి కనెక్షన్ సరిచూసుకోండి.';
            controller.error(friendlyErr);
        }
    }

    function processVoiceCommand(raw) {
        let text = (raw || '').trim();
        if (!text) return { type: 'none', query: '' };
        const lower = text.toLowerCase();

        // 1. Clear / Reset commands
        const clearPatterns = [
            /^clear(\s+search)?$/i,
            /^reset(\s+search)?$/i,
            /^show\s+all(\s+schemes)?$/i,
            /^all\s+schemes$/i,
            /^క్లియర్$/i,
            /^రీసెట్$/i,
            /^అన్నీ\s+చూపించు$/i,
            /^అన్ని\s+పథకాలు$/i,
            /^వెతకడం\s+ఆపు$/i,
            /^మొత్తం\s+చూపించు$/i
        ];
        if (clearPatterns.some(p => p.test(lower) || p.test(text))) {
            return { type: 'clear', query: '' };
        }

        // 2. Open Scheme commands
        let isOpen = false;
        if (/^open\s+/i.test(text)) {
            isOpen = true;
            text = text.replace(/^open\s+/i, '');
        } else if (/^ఓపెన్\s+/i.test(text)) {
            isOpen = true;
            text = text.replace(/^ఓపెన్\s+/i, '');
        } else if (/\s+ఓపెన్\s*(చేయి)?$/i.test(text)) {
            isOpen = true;
            text = text.replace(/\s+ఓపెన్\s*(చేయి)?$/i, '');
        }

        // 3. Strip common voice filler prefixes & suffixes
        let clean = text
            .replace(/^(search\s+for|search|find|show\s+me|show|look\s+for|tell\s+me\s+about)\s+/i, '')
            .replace(/\s+(schemes?|details|please)$/i, '')
            .replace(/(\s+(కోసం\s+వెతుకు|వెతుకు|చూపించు|తెలుపండి|వివరాలు|పథకాలు|పథకం|కావాలి|గురించి))+$/i, '')
            .replace(/^(గురించి\s+చెప్పు|నాకు|దయచేసి)\s+/i, '')
            .trim();

        return { type: isOpen ? 'open' : 'search', query: clean || text };
    }

    function bestVoiceMatch(spokenText) {
        const spoken = (spokenText || '').toLowerCase().trim();
        if (!spoken || spoken.length < 2) return null;

        const result = searchAndRankSchemes(spoken, activeFilter);
        if (!result.isNearMatches && result.names.length === 1) {
            return result.names[0];
        }
        return null;
    }

    let activeRecognition = null;
    let isVoiceListening = false;

    function setupVoice() {
        const voiceBtn = document.getElementById('voiceBtn');
        const status = document.getElementById('voiceStatus');
        const searchInput = document.getElementById('searchInput');
        const clearBtn = document.getElementById('clearSearchBtn');
        const hintsWrap = document.getElementById('voiceCommandHints');
        if (!voiceBtn || !status || !searchInput) return;

        function updateVoiceTooltips(activeLang) {
            const lang = activeLang || (window.getLang ? window.getLang() : 'te');
            const isEn = lang === 'en';
            if (isVoiceListening) {
                const stopText = window.t ? window.t('voiceStopListening') : (isEn ? 'Stop voice recording' : 'వాయిస్ రికార్డింగ్ ఆపండి');
                voiceBtn.setAttribute('title', stopText);
                voiceBtn.setAttribute('aria-label', stopText);
            } else {
                const titleText = window.t ? window.t('voiceBtnTitle') : (isEn ? 'Search by voice (Telugu / English)' : 'వాయిస్ ద్వారా వెతకండి (తెలుగు / English)');
                const ariaText = window.t ? window.t('voiceBtnAria') : (isEn ? 'Search by voice' : 'వాయిస్ ద్వారా వెతకండి');
                voiceBtn.setAttribute('title', titleText);
                voiceBtn.setAttribute('aria-label', ariaText);
            }

            if (clearBtn) {
                const clearText = window.t ? window.t('clearSearchAria') : (isEn ? 'Clear search' : 'శోధన క్లియర్ చేయండి');
                clearBtn.setAttribute('title', clearText);
                clearBtn.setAttribute('aria-label', clearText);
            }

            if (hintsWrap) {
                if (isEn) {
                    hintsWrap.innerHTML = `
                        <span class="voice-hint-title" id="voiceHintTitle">
                            <span aria-hidden="true">💡</span> <span>Voice Commands:</span>
                        </span>
                        <button type="button" class="voice-hint-chip" data-action="voice-hint" data-query="Aarogyasri">"Aarogyasri"</button>
                        <button type="button" class="voice-hint-chip" data-action="voice-hint" data-query="maternity schemes">"Maternity schemes"</button>
                        <button type="button" class="voice-hint-chip" data-action="voice-hint" data-query="cancer treatment">"Cancer treatment"</button>
                        <button type="button" class="voice-hint-chip" data-action="voice-hint" data-query="dialysis">"Dialysis"</button>
                        <button type="button" class="voice-hint-chip" data-action="voice-hint" data-query="104">"104"</button>
                        <button type="button" class="voice-hint-chip" data-action="voice-hint" data-query="clear">"Clear"</button>
                    `;
                } else {
                    hintsWrap.innerHTML = `
                        <span class="voice-hint-title" id="voiceHintTitle">
                            <span aria-hidden="true">💡</span> <span>వాయిస్ ఆదేశాలు:</span>
                        </span>
                        <button type="button" class="voice-hint-chip" data-action="voice-hint" data-query="ఆరోగ్యశ్రీ">"ఆరోగ్యశ్రీ"</button>
                        <button type="button" class="voice-hint-chip" data-action="voice-hint" data-query="గర్భిణీ స్త్రీల పథకాలు">"గర్భిణుల పథకాలు"</button>
                        <button type="button" class="voice-hint-chip" data-action="voice-hint" data-query="క్యాన్సర్ చికిత్స">"క్యాన్సర్ చికిత్స"</button>
                        <button type="button" class="voice-hint-chip" data-action="voice-hint" data-query="డయాలసిస్">"డయాలసిస్"</button>
                        <button type="button" class="voice-hint-chip" data-action="voice-hint" data-query="104">"104"</button>
                        <button type="button" class="voice-hint-chip" data-action="voice-hint" data-query="క్లియర్">"క్లియర్"</button>
                    `;
                }
            }
        }
        window.updateVoiceUI = updateVoiceTooltips;
        updateVoiceTooltips();

        function syncClearButton() {
            if (clearBtn) {
                clearBtn.style.display = searchInput.value.trim().length > 0 ? 'inline-flex' : 'none';
            }
        }

        if (clearBtn) {
            clearBtn.addEventListener('click', () => {
                if (typeof window.setSearchLoading === 'function') {
                    window.setSearchLoading(false);
                }
                searchInput.value = '';
                syncClearButton();
                renderSchemeCards(true);
                if (typeof updateSearchFeedback === 'function') {
                    updateSearchFeedback('', 0, false, false);
                }
                status.className = 'voice-status';
                status.textContent = '';
                searchInput.focus();
            });
        }

        searchInput.addEventListener('input', syncClearButton);

        function speakText(text, lang = 'te') {
            if (!text || !text.trim()) return;
            if (window.AudioController && typeof window.AudioController.play === 'function') {
                return window.AudioController.play(text, { lang: lang });
            }
        }

        window.speakText = speakText;
        window.speakTts = speakText;

        function announceSearchResults(query, count, firstSchemeName, speakAloud = false) {
            if (!query) return;
            const currentLang = window.getLang ? window.getLang() : 'te';
            const isEn = currentLang === 'en';
            let summaryText = '';
            if (count > 0) {
                const schemeObj = schemesCatalog[firstSchemeName] || {};
                const firstDisplayName = isEn ? (schemeObj.english_name || firstSchemeName) : (schemeObj.telugu_name || firstSchemeName);
                if (isEn) {
                    summaryText = `Found ${count} scheme${count > 1 ? 's' : ''} for "${query}". First result is ${firstDisplayName}.`;
                } else {
                    summaryText = `"${query}" కోసం ${count} పథకాలు లభించాయి. మొదటి ఫలితం ${firstDisplayName}.`;
                }
            } else {
                if (isEn) {
                    summaryText = `No schemes found for "${query}". Please try another keyword.`;
                } else {
                    summaryText = `"${query}" కోసం పథకాలు లభించలేదు. దయచేసి వేరే పదంతో ప్రయత్నించండి.`;
                }
            }
            // Only speak aloud if explicitly requested by voice search mode
            if (speakAloud) {
                speakText(summaryText, isEn ? 'en' : 'te');
            }
        }
        window.announceSearchResults = announceSearchResults;

        function stopListening(announce = true) {
            const wasListening = isVoiceListening;
            if (activeRecognition) {
                try {
                    activeRecognition.stop();
                } catch (_) {}
            }
            isVoiceListening = false;
            voiceBtn.classList.remove('listening');
            voiceBtn.setAttribute('aria-pressed', 'false');
            updateVoiceTooltips();
            if (wasListening && announce) {
                const isEn = window.getLang && window.getLang() === 'en';
                speakTts(isEn ? 'Voice recognition ended.' : 'వాయిస్ గుర్తింపు ముగిసింది.', isEn ? 'en' : 'te');
            }
        }

        function executeVoiceQuery(text) {
            const cmd = processVoiceCommand(text);
            const isEn = window.getLang && window.getLang() === 'en';

            if (cmd.type === 'clear') {
                searchInput.value = '';
                syncClearButton();
                renderSchemeCards(true);
                status.className = 'voice-status';
                status.innerHTML = `🔄 ${window.t ? window.t('voiceSearchCleared') : (isEn ? 'Search cleared' : 'శోధన క్లియర్ చేయబడింది')}`;
                speakTts(isEn ? 'Search cleared.' : 'శోధన క్లియర్ చేయబడింది.', isEn ? 'en' : 'te');
                return;
            }

            const cleanQuery = cmd.query || text;
            searchInput.value = cleanQuery;
            syncClearButton();
            renderSchemeCards(true);

            if (cleanQuery.length >= 2 && window.SmartGovUX?.addRecentSearch) {
                window.SmartGovUX.addRecentSearch(cleanQuery);
            }

            const match = bestVoiceMatch(cleanQuery);
            if (match) {
                const schemeObj = schemesCatalog[match];
                const displayName = isEn ? (schemeObj?.english_name || match) : (schemeObj?.telugu_name || match);
                status.className = 'voice-status match-found';
                status.innerHTML = `🎯 <strong>${displayName}</strong> (${window.t ? window.t('voiceOpeningScheme') : (isEn ? 'Opening scheme details...' : 'పథకం వివరాలు తెరుస్తున్నాం...')})`;
                fetchScheme(match);
                announceSearchResults(cleanQuery, 1, match);
            } else {
                const matchedCards = document.querySelectorAll('.scheme-card').length;
                const isNearMode = document.querySelector('.near-matches-banner') !== null;
                status.className = 'voice-status' + (isNearMode || matchedCards > 0 ? ' match-found' : '');

                if (isNearMode && matchedCards > 0) {
                    const topCard = document.querySelector('.scheme-card[data-scheme]');
                    const topSchemeName = topCard ? topCard.getAttribute('data-scheme') : null;
                    const topSchemeObj = topSchemeName ? schemesCatalog[topSchemeName] : null;
                    const topSchemeLabel = topSchemeObj ? (isEn ? topSchemeName : (topSchemeObj.telugu_name || topSchemeName)) : null;

                    let recHtml = '';
                    if (topSchemeName && topSchemeLabel) {
                        recHtml = ` <button type="button" class="voice-status-recommendation" data-action="open-scheme" data-scheme="${window.escapeHtml(topSchemeName)}">👉 ${window.escapeHtml(topSchemeLabel)} (${isEn ? 'Open' : 'తెరువు'})</button>`;
                    }

                    status.innerHTML = `💡 <strong>"${window.escapeHtml(cleanQuery)}"</strong> &bull; ${matchedCards} ${isEn ? 'near/related schemes found' : 'సమీప పథకాలు లభించాయి'}${recHtml}`;
                    announceSearchResults(cleanQuery, matchedCards, topSchemeName || '', true);
                } else if (matchedCards > 0) {
                    status.innerHTML = `🔍 <strong>"${window.escapeHtml(cleanQuery)}"</strong> &bull; ${matchedCards} ${isEn ? 'schemes found' : 'పథకాలు లభించాయి'}`;
                    const topCard = document.querySelector('.scheme-card[data-scheme]');
                    const topSchemeName = topCard ? topCard.getAttribute('data-scheme') : '';
                    announceSearchResults(cleanQuery, matchedCards, topSchemeName, true);
                } else {
                    status.innerHTML = `⚠️ <strong>"${window.escapeHtml(cleanQuery)}"</strong> &bull; ${isEn ? 'No schemes found. Try keywords like "Aarogyasri", "Eye Care", "Dialysis", "108".' : 'పథకాలు లభించలేదు. "ఆరోగ్యశ్రీ", "కంటి వెలుగు", "డయాలసిస్", "108" వంటి పదాలతో ప్రయత్నించండి.'}`;
                    announceSearchResults(cleanQuery, 0, '', true);
                }

                const grid = document.getElementById('schemesGrid');
                if (grid && matchedCards > 0) {
                    grid.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                }
            }
        }
        window.executeVoiceQuery = executeVoiceQuery;

        function startListening() {
            const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SpeechRecognition) {
                const isEn = window.getLang && window.getLang() === 'en';
                const notSup = window.t ? window.t('voiceNotSupported') : (isEn ? 'Voice search is not supported on this browser. Please use Chrome, Edge, or Safari.' : 'ఈ బ్రౌజర్ వాయిస్ సెర్చ్‌కు మద్దతు ఇవ్వదు. దయచేసి Chrome లేదా Edge ఉపయోగించండి.');
                status.className = 'voice-status';
                status.textContent = notSup;
                return;
            }

            if (isVoiceListening) {
                stopListening();
                return;
            }

            try {
                if (activeRecognition) {
                    try { activeRecognition.abort(); } catch(_) {}
                }

                const recognition = new SpeechRecognition();
                activeRecognition = recognition;

                const currentLang = window.getLang && window.getLang() === 'en' ? 'en-IN' : 'te-IN';
                recognition.lang = currentLang;
                recognition.continuous = false;
                recognition.interimResults = true;
                recognition.maxAlternatives = 3;

                recognition.onstart = () => {
                    isVoiceListening = true;
                    voiceBtn.classList.add('listening');
                    voiceBtn.setAttribute('aria-pressed', 'true');
                    updateVoiceTooltips();
                    status.className = 'voice-status active-listening';
                    const isEn = window.getLang && window.getLang() === 'en';
                    status.innerHTML = `<span class="listening-dot">🔴</span> ${window.t ? window.t('voiceListening') : (isEn ? 'Listening... please speak in English or Telugu' : 'వింటున్నాం... తెలుగు లేదా ఇంగ్లీషులో మాట్లాడండి')}`;
                    speakTts(isEn ? 'Voice recognition started. Listening.' : 'వాయిస్ గుర్తింపు ప్రారంభమైంది. వింటున్నాం.', isEn ? 'en' : 'te');
                };

                recognition.onresult = event => {
                    let interimTranscript = '';
                    let finalTranscript = '';

                    for (let i = event.resultIndex; i < event.results.length; ++i) {
                        if (event.results[i].isFinal) {
                            finalTranscript += event.results[i][0].transcript;
                        } else {
                            interimTranscript += event.results[i][0].transcript;
                        }
                    }

                    const spoken = (finalTranscript || interimTranscript).trim();

                    if (interimTranscript && !finalTranscript) {
                        status.className = 'voice-status active-listening';
                        status.innerHTML = `🎙️ <em>"${spoken}..."</em>`;
                        searchInput.value = spoken;
                        syncClearButton();
                        renderSchemeCards(true);
                        return;
                    }

                    if (finalTranscript) {
                        executeVoiceQuery(finalTranscript);
                    }
                };

                recognition.onerror = event => {
                    stopListening();
                    const errCode = event.error || 'unknown';
                    if (errCode === 'aborted') return;
                    const localizedMsg = window.SmartGovI18n ? window.SmartGovI18n.getLocalizedMicError(errCode) : (window.getLang && window.getLang() === 'en' ? `Microphone error: ${errCode}` : `మైక్ లోపం: ${errCode}`);
                    status.className = 'voice-status';
                    status.textContent = localizedMsg;
                };

                recognition.onend = () => {
                    stopListening();
                };

                recognition.start();
            } catch (err) {
                stopListening();
                status.className = 'voice-status';
                status.textContent = window.t ? window.t('voiceStartError') : 'మైక్ ప్రారంభం కాలేదు. మళ్లీ ప్రయత్నించండి.';
            }
        }

        voiceBtn.addEventListener('click', startListening);
    }

    function setupInstallPrompt() {
        const installBtn = document.getElementById('installAppBtn');
        if (!installBtn) return;

        window.addEventListener('beforeinstallprompt', e => {
            e.preventDefault();
            deferredInstallPrompt = e;
            installBtn.style.display = 'inline-flex';
        });

        installBtn.addEventListener('click', async () => {
            if (deferredInstallPrompt) {
                deferredInstallPrompt.prompt();
                const { outcome } = await deferredInstallPrompt.userChoice;
                if (outcome === 'accepted') {
                    installBtn.style.display = 'none';
                }
                deferredInstallPrompt = null;
            } else {
                const guideModal = document.getElementById('installGuideModal');
                if (guideModal && typeof guideModal.showModal === 'function') {
                    guideModal.showModal();
                }
            }
        });

        window.addEventListener('appinstalled', () => {
            installBtn.style.display = 'none';
            deferredInstallPrompt = null;
        });
    }

    // Event Delegation Handler
    document.addEventListener('click', e => {
        const actionTarget = e.target.closest('[data-action]');
        if (!actionTarget) return;

        const action = actionTarget.dataset.action;

        if (action === 'close-install-guide') {
            const guideModal = document.getElementById('installGuideModal');
            if (guideModal && typeof guideModal.close === 'function') {
                guideModal.close();
            }
        } else if (action === 'open-scheme') {
            if (e.target.closest('.favorite-btn')) return;
            const scheme = actionTarget.dataset.scheme;
            if (scheme) fetchScheme(scheme);
        } else if (action === 'set-filter') {
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.classList.remove('active');
                btn.setAttribute('aria-pressed', 'false');
            });
            actionTarget.classList.add('active');
            actionTarget.setAttribute('aria-pressed', 'true');
            activeFilter = actionTarget.dataset.filter || 'all';
            renderSchemeCards(true);
        } else if (action === 'set-lang') {
            const lang = actionTarget.dataset.lang || 'te';
            // Stop active audio and clear audio queue immediately upon language switch
            if (window.AudioController && typeof window.AudioController.onLanguageChange === 'function') {
                window.AudioController.onLanguageChange(lang);
            }
            if (window.SmartGovI18n && typeof window.SmartGovI18n.setLanguage === 'function') {
                window.SmartGovI18n.setLanguage(lang);
            } else if (window.SmartGovI18n && typeof window.SmartGovI18n.setLang === 'function') {
                window.SmartGovI18n.setLang(lang);
            } else if (typeof window.setLang === 'function') {
                window.setLang(lang);
            }
            populateSchemeDropdown(lang);
            renderSchemeCards(true);
            updateChatUi();
            if (currentSchemeData) {
                displayResult(currentSchemeData, true);
            }
            if (typeof window.populateCompareDropdowns === 'function') {
                window.populateCompareDropdowns();
                window.renderComparison();
            }
            if (typeof window.updateVoiceUI === 'function') {
                window.updateVoiceUI(lang);
            }
        } else if (action === 'voice-hint') {
            const query = actionTarget.dataset.query;
            if (query && typeof window.executeVoiceQuery === 'function') {
                window.executeVoiceQuery(query);
            }
        } else if (action === 'clear-search-and-show-all') {
            if (typeof window.setSearchLoading === 'function') {
                window.setSearchLoading(false);
            }
            const searchInput = document.getElementById('searchInput');
            if (searchInput) searchInput.value = '';
            const clearBtn = document.getElementById('clearSearchBtn');
            if (clearBtn) clearBtn.style.display = 'none';
            const status = document.getElementById('voiceStatus');
            if (status) {
                status.className = 'voice-status';
                status.textContent = '';
            }
            if (typeof updateSearchFeedback === 'function') {
                updateSearchFeedback('', 0, false, false);
            }
            renderSchemeCards(true);
            if (searchInput) searchInput.focus();
        } else if (action === 'toggle-contrast') {
            if (window.SmartGovUX && typeof window.SmartGovUX.toggleContrast === 'function') {
                window.SmartGovUX.toggleContrast();
            } else {
                document.body.classList.toggle('high-contrast');
            }
        } else if (action === 'decrease-font' || action === 'increase-font' || action === 'reset-font') {
            document.querySelectorAll('.font-btn').forEach(btn => btn.classList.remove('active'));
            actionTarget.classList.add('active');
            
            const html = document.documentElement;
            if (action === 'decrease-font') {
                html.style.setProperty('--app-font-size', '14px');
            } else if (action === 'increase-font') {
                html.style.setProperty('--app-font-size', '18px');
            } else {
                html.style.setProperty('--app-font-size', '16px');
            }
        } else if (action === 'open-chat') {
            updateChatUi();
            const dialog = document.getElementById('chatModal');
            if (dialog) dialog.showModal();
        } else if (action === 'close-chat') {
            const dialog = document.getElementById('chatModal');
            if (dialog) dialog.close();
        } else if (action === 'toggle-dashboard' || action === 'open-dashboard') {
            const dashboardModal = document.getElementById('schemesDashboardModal');
            if (dashboardModal) {
                if (typeof dashboardModal.showModal === 'function') {
                    dashboardModal.showModal();
                } else {
                    dashboardModal.setAttribute('open', '');
                }
                if (typeof window.mountSchemesDashboard === 'function') {
                    const activeLang = window.getLang ? window.getLang() : 'te';
                    window.mountSchemesDashboard('schemesDashboardRoot', window.schemesCatalog || {}, activeLang);
                }
            }
        } else if (action === 'close-dashboard') {
            const dashboardModal = document.getElementById('schemesDashboardModal');
            if (dashboardModal) {
                if (typeof dashboardModal.close === 'function') {
                    dashboardModal.close();
                } else {
                    dashboardModal.removeAttribute('open');
                }
            }
        } else if (action === 'open-map') {
            const container = document.getElementById('fullScreenMapContainer');
            if (container) {
                container.style.display = 'flex';
                if (window.SmartGovEnhanced?.initMap) {
                    window.SmartGovEnhanced.initMap();
                }
            }
        } else if (action === 'close-map') {
            const container = document.getElementById('fullScreenMapContainer');
            if (container) container.style.display = 'none';
        } else if (action === 'open-emergency') {
            const dialog = document.getElementById('emergencyModal');
            if (dialog) dialog.showModal();
        } else if (action === 'close-emergency') {
            const dialog = document.getElementById('emergencyModal');
            if (dialog) dialog.close();
        } else if (action === 'filter-keyword') {
            const kw = actionTarget.dataset.kw;
            const input = document.getElementById('searchInput');
            if (input && kw) {
                input.value = kw;
                if (window.SmartGovUX?.addRecentSearch) {
                    window.SmartGovUX.addRecentSearch(kw);
                }
                renderSchemeCards(true);
                const targetGrid = document.getElementById('schemesGrid') || document.querySelector('.schemes-grid-section');
                if (targetGrid) {
                    targetGrid.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            }
        } else if (action === 'apply-recent-search') {
            const query = actionTarget.dataset.query;
            const input = document.getElementById('searchInput');
            if (input && query) {
                input.value = query;
                if (window.SmartGovUX?.addRecentSearch) {
                    window.SmartGovUX.addRecentSearch(query);
                }
                renderSchemeCards(true);
                const matchedCards = document.querySelectorAll('.scheme-card').length;
                const topCard = document.querySelector('.scheme-card[data-scheme]');
                const topSchemeName = topCard ? topCard.getAttribute('data-scheme') : '';
                if (typeof announceSearchResults === 'function') {
                    announceSearchResults(query, matchedCards, topSchemeName);
                }
                input.focus();
            }
        } else if (action === 'remove-recent-search') {
            e.stopPropagation();
            const query = actionTarget.dataset.query;
            if (query && window.SmartGovUX?.removeRecentSearch) {
                window.SmartGovUX.removeRecentSearch(query);
            }
        } else if (action === 'clear-recent-searches') {
            e.stopPropagation();
            if (window.SmartGovUX?.clearRecentSearches) {
                window.SmartGovUX.clearRecentSearches();
            }
        } else if (action === 'listen-scheme') {
            const sName = actionTarget.dataset.scheme || currentSchemeName;
            const sData = schemesCatalog[sName];
            if (sData) {
                const isEn = window.getLang && window.getLang() === 'en';
                const title = isEn ? sName : (sData.telugu_name || sName);
                const desc = isEn ? (sData.english_description || sData.simplified?.benefits || '') : (sData.telugu_description || sData.telugu?.benefits || '');
                if (window.AudioController) {
                    window.AudioController.play(`${title}. ${desc}`, {
                        lang: isEn ? 'en' : 'te',
                        title: title,
                        triggerBtn: actionTarget
                    });
                }
            }
        } else if (action === 'speak-section') {
            if (e) {
                e.preventDefault();
                e.stopPropagation();
            }
            const secTitle = actionTarget.dataset.title || '';
            const secText = actionTarget.dataset.text || '';
            if (window.AudioController && secText) {
                const isEn = window.getLang && window.getLang() === 'en';
                // Toggle play/pause if this section is currently active
                const snap = window.AudioController.getState();
                if (snap.currentSection && snap.currentSection.title === secTitle && (snap.isPlaying || snap.isPaused)) {
                    if (snap.isPlaying) {
                        window.AudioController.pause();
                    } else {
                        window.AudioController.resume();
                    }
                } else {
                    window.AudioController.play(`${secTitle}: ${secText}`, {
                        lang: isEn ? 'en' : 'te',
                        title: secTitle,
                        triggerBtn: actionTarget
                    });
                }
            }
        } else if (action === 'open-guided' || action === 'start-guided-mode') {
            const sName = actionTarget.dataset.scheme || currentSchemeName || Object.keys(schemesCatalog)[0];
            if (window.SmartGovUX?.startGuidedMode) {
                window.SmartGovUX.startGuidedMode(sName);
            }
        } else if (action === 'print-scheme') {
            const sName = actionTarget.dataset.scheme || currentSchemeName;
            if (window.SmartGovEnhanced?.printFullScheme) {
