        `;

        let currentStageIdx = 0;

        const updateStageUI = (stage) => {
            const bar = document.getElementById('docScanProgressBar');
            const percentLabel = document.getElementById('docScanPercent');
            const badge = document.getElementById('docScanStageBadge');
            const titleEl = document.getElementById('docScanTitle');
            const subEl = document.getElementById('docScanSubtitle');
