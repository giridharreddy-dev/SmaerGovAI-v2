            if (bar) bar.style.width = stage.pct + '%';
            if (percentLabel) percentLabel.textContent = stage.pct + '%';
            if (track) track.setAttribute('aria-valuenow', stage.pct);
            if (badge) badge.textContent = stage.badge;
            if (titleEl) titleEl.textContent = stage.title;
            if (subEl) subEl.textContent = stage.sub;

            for (let i = 1; i <= 4; i++) {
                const stepEl = document.getElementById('docStep' + i);
                if (stepEl) {
                    if (i < stage.step) {
                        stepEl.className = 'doc-scan-step done';
                    } else if (i === stage.step) {
                        stepEl.className = 'doc-scan-step active';
                    } else {
                        stepEl.className = 'doc-scan-step';
                    }
                }
            }
        };

        docProgressTimer = setInterval(() => {
            currentStageIdx++;
            if (currentStageIdx < stages.length) {
                updateStageUI(stages[currentStageIdx]);
            } else {
                clearInterval(docProgressTimer);
                docProgressTimer = null;
            }
        }, 1300);

        return {
