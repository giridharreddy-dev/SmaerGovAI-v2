<script nonce="<%= csp_nonce %>">
    const schemesCatalog = <%- JSON.stringify(schemes) %>;
    window.schemesCatalog = schemesCatalog;
    const schemeNames = <%- JSON.stringify(scheme_names) %>;
    const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
    const iconMap = {
        hospital: '🏥',
        ambulance: '🚑',
        'mobile-clinic': '🩺',
        shield: '🛡️',
        clinic: '🏥',
        'phone-doctor': '📱',
        diet: '🥗',
        eye: '👁️',
        baby: '👶',
        kidney: '🫘',
        nutrition: '🥣',
        medicine: '💊',
        maternal: '🤰',
        emergency: '🚨',
        insurance: '🛡️',
        mental: '🧠',
        tb: '🫁'
    };

    let activeFilter = 'all';
    let currentRequestId = null;
    let currentSchemeName = null;
    let currentSchemeData = null;
    let deferredInstallPrompt = null;

    // Pre-compute comprehensive lowercase search haystacks once on load
    function buildRichHaystack(name, data) {
        if (!data) return (name || '').toLowerCase();
        const parts = [
            name,
            data.telugu_name || '',
            data.category || '',
            data.level || '',
            data.simplified?.description || data.english_description || '',
            data.telugu?.description || data.telugu_description || '',
            data.simplified?.benefits || data.benefit_amount || data.coverage_type || '',
            data.telugu?.benefits || data.benefit_amount_te || data.coverage_type_te || '',
            data.simplified?.eligibility || data.target_beneficiary || '',
            data.telugu?.eligibility || data.target_beneficiary_te || '',
            data.simplified?.documents || '',
            data.simplified?.steps || data.telugu?.steps || '',
            ...(data.keywords || []),
            ...(data.key_treatments || []),
            ...(data.key_treatments_te || []),
            ...(data.required_documents || []).map(d => (d.name || '') + ' ' + (d.name_te || '')),
            data.helpline_numbers || '',
            data.facility_type || '',
            data.facility_type_te || '',
            data.source_name || '',
            data.original_complex_text || ''
        ];
        return parts.join(' ').toLowerCase();
    }

    const searchHaystacks = {};
    for (const name of schemeNames) {
        searchHaystacks[name] = buildRichHaystack(name, schemesCatalog[name]);
    }

    // Incremental batch registrar to ingest streamed/batch scraped schemes without resetting UI state
    window.registerNewSchemesBatch = function (newBatchMap = {}, isFullReplace = false) {
        if (!newBatchMap || typeof newBatchMap !== 'object') return;
        let addedCount = 0;
        for (const [name, data] of Object.entries(newBatchMap)) {
            if (!schemesCatalog[name] || isFullReplace) {
                schemesCatalog[name] = data;
                searchHaystacks[name] = buildRichHaystack(name, data);
                if (!schemeNames.includes(name)) {
                    schemeNames.push(name);
                    addedCount++;
                }
            }
        }
        if (addedCount > 0 || isFullReplace) {
            schemeNames.sort();
            window.schemesCatalog = schemesCatalog;
            window.schemeNames = schemeNames;
            populateSchemeDropdown();
            // Re-render cards preserving current filter/search if user isn't actively selecting a scheme
            if (!currentSchemeName) {
                renderSchemeCards(false);
            }
            // Update comparison dropdowns if defined
            if (typeof window.populateCompareOptions === 'function') {
                window.populateCompareOptions();
            }
        }
    };

    function matchesFilter(data) {
        if (activeFilter === 'all') return true;
        if (activeFilter === 'ap') return data.level === 'Andhra Pradesh';
        return data.level === 'National';
    }

    // Levenshtein distance for fuzzy/typo-tolerant matching
    function levenshteinDistance(s1, s2) {
        if (s1 === s2) return 0;
        const l1 = s1.length;
        const l2 = s2.length;
        if (l1 === 0) return l2;
        if (l2 === 0) return l1;
        let prev = new Array(l2 + 1);
        let curr = new Array(l2 + 1);
        for (let j = 0; j <= l2; j++) prev[j] = j;
        for (let i = 1; i <= l1; i++) {
            curr[0] = i;
            const c1 = s1.charCodeAt(i - 1);
            for (let j = 1; j <= l2; j++) {
                const cost = c1 === s2.charCodeAt(j - 1) ? 0 : 1;
                curr[j] = Math.min(
                    prev[j] + 1,
                    curr[j - 1] + 1,
                    prev[j - 1] + cost
                );
            }
            for (let j = 0; j <= l2; j++) prev[j] = curr[j];
        }
        return curr[l2];
    }

    function stringSimilarity(s1, s2) {
        if (!s1 || !s2) return 0;
        if (s1 === s2) return 1;
        const dist = levenshteinDistance(s1, s2);
        const maxLen = Math.max(s1.length, s2.length);
        return maxLen === 0 ? 1 : Math.max(0, 1 - dist / maxLen);
    }

    function normalizeTextForFuzzy(text) {
        return (text || '')
            .toLowerCase()
            .replace(/[,\/#!$%\^&\*;:{}=\-_`~()?"'’]/g, ' ')
            .replace(/\s+/g, ' ')
            .trim();
    }

    // Health condition & keyword synonym map to bridge common speech mistakes & phonetic variations
    const HEALTH_SYNONYMS = [
        { terms: ['aarogyasri', 'arogyasri', 'arogyasree', 'arogyashree', 'aarogyasree', 'arogya sree', 'ఆరోగ్యశ్రీ', 'ఆరోగ్య శ్రీ', 'ఆరోగ్యస్రీ', 'ఆరోగ్యశ్రి', 'ఆరోగ్య', 'arogya'], target: 'aarogyasri', boostSchemes: ['Dr. NTR Vaidya Seva (AP Cashless Hospital Care)', 'Dr. YSR Aarogya Asara (Post-Operative Financial Allowance)', 'Jagananna Aarogya Suraksha (Doorstep Health Screening & Specialist Camps)'] },
        { terms: ['asara', 'aasara', 'assara', 'ఆసరా', 'ఆసర', 'post operative', 'surgery aid', 'recuperation', 'wage compensation'], target: 'asara', boostSchemes: ['Dr. YSR Aarogya Asara (Post-Operative Financial Allowance)'] },
        { terms: ['kanti', 'velugu', 'eye', 'eyes', 'cataract', 'vision', 'spectacles', 'glasses', 'కంటి', 'కన్ను', 'కంటి వెలుగు', 'కంటివెలుగు', 'చూపు', 'కళ్లద్దాలు', 'క్యాటరాక్ట్', 'నేత్ర'], target: 'eye', boostSchemes: ['Dr. YSR Kanti Velugu (Comprehensive Universal Eye Care)', 'National Programme for Control of Blindness (NPCBVI)'] },
        { terms: ['dialysis', 'dialisis', 'kidney', 'ckd', 'uddanam', 'డయాలసిస్', 'డయాలిసిస్', 'మూత్రపిండ', 'డయాలసిజ్', 'కిడ్నీ'], target: 'dialysis', boostSchemes: ['AP Free Dialysis and CKD Financial Aid Scheme', 'Pradhan Mantri National Dialysis Programme'] },
        { terms: ['talli', 'bidda', 'thalli', 'delivery', 'maternity', 'pregnant', 'pregnancy', '102', 'mother', 'safe delivery', 'తల్లి బిడ్డ', 'తల్లిబిడ్డ', 'ప్రసవం', 'గర్భిణి', 'గర్భిణీ', 'మాతృత్వ', 'జనని'], target: 'maternity', boostSchemes: ['Janani Suraksha Yojana (Safe Motherhood Cash Support)', 'Janani Shishu Suraksha Karyakram (Free Delivery Care)', 'Pradhan Mantri Matru Vandana Yojana (PMMVY)', 'Pradhan Mantri Surakshit Matritva Abhiyan (PMSMA)'] },
        { terms: ['suraksha', 'suraksh', 'aarogya suraksha', 'jagananna', 'doorstep', 'camps', 'ఆరోగ్య సురక్ష', 'సురక్ష'], target: 'suraksha', boostSchemes: ['Jagananna Aarogya Suraksha (Doorstep Health Screening & Specialist Camps)'] },
        { terms: ['104', 'one zero four', 'ఒకటి సున్నా నాలుగు', 'mobile medical', 'mmu', 'మొబైల్ క్లినిక్'], target: '104', boostSchemes: ['AP 104 Mobile Medical Units'] },
        { terms: ['108', 'one zero eight', 'ఒకటి సున్నా ఎనిమిది', 'ambulance', 'emergency', 'ఆంబులెన్స్', 'అత్యవసర'], target: '108', boostSchemes: ['AP 108 Emergency Ambulance Service'] },
        { terms: ['ayushman', 'pmjay', 'aayushman', 'pm-jay', 'pm jay', 'ఆయుష్మాన్', 'పిఎమ్ జేవై', 'abha', 'health account'], target: 'ayushman', boostSchemes: ['Ayushman Bharat PM-JAY (National Health Cover)', 'Ayushman Arogya Mandir (Free Primary Health Care)', 'Ayushman Bharat Health Account (ABHA)'] },
        { terms: ['cancer', 'cansar', 'tumour', 'tumor', 'oncology', 'క్యాన్సర్', 'క్యాన్సరు', 'క్యాన్సర్ చికిత్స'], target: 'cancer', boostSchemes: ['Dr. NTR Vaidya Seva (AP Cashless Hospital Care)', 'Dr. YSR Aarogya Asara (Post-Operative Financial Allowance)', 'Ayushman Arogya Mandir (Free Primary Health Care)'] },
        { terms: ['cochlear', 'cochler', 'cochlier', 'hearing', 'deaf', 'ear', 'speech therapy', 'కాక్లియర్', 'వినికిడి', 'చెవుడు'], target: 'hearing', boostSchemes: ['AP Free Cochlear Implant Scheme (Child Hearing Restoration)', 'National Programme for Prevention of Deafness (NPPCD)'] },
