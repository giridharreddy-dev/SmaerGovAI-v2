    function displayResult(data, preventScroll = false) {
        if (data.error) {
            showError(data.error);
            return;
        }

        // Cache recently searched scheme summary for offline access
        try {
            if (data && data.scheme_name) {
                let recentMap = {};
                try { recentMap = JSON.parse(localStorage.getItem('smartgov_recent_schemes') || '{}'); } catch(e){}
                recentMap[data.scheme_name] = data;
                localStorage.setItem('smartgov_recent_schemes', JSON.stringify(recentMap));

                if (navigator.serviceWorker && navigator.serviceWorker.controller) {
                    navigator.serviceWorker.controller.postMessage({
                        type: 'CACHE_SCHEME_SUMMARY',
                        scheme: data
                    });
                }
            }
        } catch(e) {}

        currentRequestId = data.request_id;
        currentSchemeName = data.scheme_name;
        currentSchemeData = data;
        window.currentRequestId = data.request_id;
        window.currentSchemeName = data.scheme_name;
        const scheme = schemesCatalog[data.scheme_name] || {
            telugu_name: data.telugu_name || data.scheme_name,
            level: data.level || 'Andhra Pradesh',
            category: data.category || 'Healthcare Document',
            simplified: data.simplified,
            telugu: data.telugu,
            benefit_amount: data.benefit_amount || 'Cashless Healthcare Coverage',
            benefit_amount_te: data.benefit_amount_te || 'నగదు రహిత వైద్య రక్షణ',
            required_documents: Array.isArray(data.required_documents) && data.required_documents.length > 0 ? data.required_documents : [
                { name: "Aadhaar Card", name_te: "ఆధార్ కార్డు", optional: false },
                { name: "Rice Card / White Ration Card", name_te: "బియ్యం కార్డు / తెల్ల రేషన్ కార్డు", optional: false },
                { name: "Doctor Prescription / Medical Records", name_te: "డాక్టర్ ప్రిస్క్రిప్షన్ / వైద్య పత్రాలు", optional: true }
            ],
            eligibility_questions: Array.isArray(data.eligibility_questions) && data.eligibility_questions.length > 0 ? data.eligibility_questions : [
                { question_te: "మీరు ఆంధ్రప్రదేశ్ రాష్ట్ర నివాసితులా?", question_en: "Are you a resident of Andhra Pradesh?", weight: "critical" },
                { question_te: "ఈ పత్రంలో పేర్కొన్న అర్హత ప్రమాణాలను మీరు కలిగి ఉన్నారా?", question_en: "Does your family satisfy the criteria described in this document?", weight: "high" }
            ],
            key_treatments: data.key_treatments || [],
            key_treatments_te: data.key_treatments_te || [],
            source_name: data.source_name,
            source_url: data.source_url
        };

        if (!schemesCatalog[data.scheme_name]) {
            schemesCatalog[data.scheme_name] = scheme;
        }

        const currentLang = window.getLang ? window.getLang() : 'te';
        const isEn = currentLang === 'en';

