        { terms: ['disability', 'handicapped', 'sadarem', 'udid', 'wheelchair', 'tricycle', 'hearing aid', 'దివ్యాంగులు', 'ట్రైసైకిల్', 'వికలాంగులు', 'సదరం'], target: 'disability', boostSchemes: ['Assistance to Disabled Persons for Purchase/Fitting of Aids (ADIP Scheme)', 'AP Free Cochlear Implant Scheme (Child Hearing Restoration)'] },
        { terms: ['ayush', 'ayurveda', 'homeopathy', 'unani', 'yoga', 'naturopathy', 'ఆయుష్', 'ఆయుర్వేదం', 'హోమియోపతి', 'యోగా'], target: 'ayush', boostSchemes: ['National AYUSH Mission (Ayurveda, Yoga & Naturopathy)'] },
        { terms: ['dental', 'teeth', 'tooth', 'dentist', 'cavity', 'oral', 'దంత', 'పంటి', 'పళ్ళు', 'నోటి'], target: 'dental', boostSchemes: ['National Oral Health Programme (NOHP - Dental Care)'] },
        { terms: ['insurance', 'employee health', 'journalist', 'ehs', 'wjhs', 'pensioner health', 'ఉద్యోగుల', 'జర్నలిస్ట్', 'బీమా'], target: 'insurance', boostSchemes: ['Employee Health Scheme (EHS - AP)', 'Working Journalists Health Scheme (WJHS - AP)', 'Ayushman Bharat - PMJAY (National Health Protection Mission)'] }
    ];

    function searchAndRankSchemes(query, filter) {
        const qNorm = normalizeTextForFuzzy(query);
        if (!qNorm) {
            window.currentNlpIntent = null;
            return {
                names: schemeNames.filter(name => {
                    const data = schemesCatalog[name];
                    if (!data) return false;
                    if (filter === 'favorites' && window.SmartGovUX && !window.SmartGovUX.isFavorite(name)) return false;
                    return matchesFilter(data);
                }),
                isNearMatches: false
            };
        }

        // Use Advanced SmartGovNLP vector search engine if available
        if (window.SmartGovNLP && typeof window.SmartGovNLP.search === 'function') {
            const nlpResult = window.SmartGovNLP.search(query, schemesCatalog);
            window.currentNlpIntent = nlpResult.detectedIntent;
            window.currentVectorSearchResults = {};
            if (nlpResult.results && Array.isArray(nlpResult.results)) {
                nlpResult.results.forEach(r => {
                    window.currentVectorSearchResults[r.name] = r;
                });
            }
            
            const filteredNames = nlpResult.results
                .filter(res => {
                    const data = schemesCatalog[res.name];
                    if (!data) return false;
                    if (filter === 'favorites' && window.SmartGovUX && !window.SmartGovUX.isFavorite(res.name)) return false;
                    return matchesFilter(data);
                })
                .map(res => res.name);

            if (filteredNames.length > 0) {
                return {
                    names: filteredNames,
                    isNearMatches: false,
                    detectedIntent: nlpResult.detectedIntent
                };
            }
        }

        const qTokens = qNorm.split(' ').filter(w => w.length > 0);
        const scored = [];

        for (const name of schemeNames) {
            const data = schemesCatalog[name];
            if (!data) continue;
            if (filter === 'favorites' && window.SmartGovUX && !window.SmartGovUX.isFavorite(name)) continue;
            if (!matchesFilter(data)) continue;

            const haystack = searchHaystacks[name] || '';
            const nameNorm = normalizeTextForFuzzy(name);
            const teNorm = normalizeTextForFuzzy(data.telugu_name || '');
            const keywords = (data.keywords || []).map(k => normalizeTextForFuzzy(k));
            const allKeywordsText = keywords.join(' ');

            let score = 0;
            let isExactOrTokenMatch = false;

            // 1. Exact match on full scheme name or Telugu name
            if (nameNorm === qNorm || teNorm === qNorm) {
                score += 150;
                isExactOrTokenMatch = true;
            } else if (nameNorm.includes(qNorm) || teNorm.includes(qNorm)) {
                score += 90;
                isExactOrTokenMatch = true;
            } else if (allKeywordsText.includes(qNorm)) {
                score += 70;
                isExactOrTokenMatch = true;
            } else if (haystack.includes(qNorm)) {
                score += 55;
                isExactOrTokenMatch = true;
            }

            // 2. Multi-word token matching (all query tokens match anywhere in haystack)
            if (qTokens.length > 1) {
                const allTokensPresent = qTokens.every(tok => haystack.includes(tok));
                if (allTokensPresent) {
                    score += 65;
                    isExactOrTokenMatch = true;
                } else {
                    const matchedTokens = qTokens.filter(tok => haystack.includes(tok));
                    if (matchedTokens.length > 0) {
                        score += Math.round((matchedTokens.length / qTokens.length) * 45);
                    }
                }
            }

            // 3. Synonym and health intent matching
            for (const syn of HEALTH_SYNONYMS) {
                const hasMatch = syn.terms.some(t => {
                    const tNorm = normalizeTextForFuzzy(t);
                    if (qNorm.includes(tNorm) || tNorm.includes(qNorm)) return true;
                    return stringSimilarity(qNorm, tNorm) >= 0.72;
                });
                if (hasMatch) {
                    if (syn.boostSchemes.includes(name)) {
                        score += 85;
                        isExactOrTokenMatch = true;
                    } else if (keywords.some(k => k.includes(syn.target)) || haystack.includes(syn.target)) {
                        score += 35;
                    }
                }
            }

            // 4. Fuzzy token matching for speech misrecognition & typing errors
            const schemeTokens = [
                ...nameNorm.split(' '),
                ...teNorm.split(' '),
                ...keywords.flatMap(k => k.split(' '))
            ].filter(w => w.length > 1);

            let tokMatchCount = 0;
            let bestTokSimTotal = 0;

            for (const qTok of qTokens) {
                if (qTok.length < 2) continue;
                let bestSim = 0;
                for (const sTok of schemeTokens) {
                    if (qTok === sTok) {
                        bestSim = 1;
                        break;
                    }
                    if (sTok.includes(qTok) || qTok.includes(sTok)) {
                        bestSim = Math.max(bestSim, 0.85);
                    } else {
                        const sim = stringSimilarity(qTok, sTok);
                        if (sim > bestSim) bestSim = sim;
                    }
                }
                if (bestSim >= 0.72) {
                    tokMatchCount++;
                    bestTokSimTotal += bestSim;
                }
            }

            if (tokMatchCount > 0) {
                score += Math.round(bestTokSimTotal * 30);
                if (tokMatchCount === qTokens.length) {
                    score += 25;
                    if (bestTokSimTotal / tokMatchCount >= 0.82) {
                        isExactOrTokenMatch = true;
                    }
                }
            }

            if (score > 0) {
                scored.push({ name, score, isExactOrTokenMatch });
            }
        }

        scored.sort((a, b) => b.score - a.score);

        // Return exact / confident matches if found
        const exactMatches = scored.filter(s => s.isExactOrTokenMatch);
        if (exactMatches.length > 0) {
            return {
                names: exactMatches.map(s => s.name),
                isNearMatches: false
            };
        }

        // Near matches fallback for speech errors / typos
        const nearMatches = scored.filter(s => s.score >= 18);
        if (nearMatches.length > 0) {
            return {
                names: nearMatches.slice(0, 8).map(s => s.name),
                isNearMatches: true
            };
        }

        return {
            names: [],
            isNearMatches: false
        };
    }

    let lastQuery = null;
    let lastFilter = null;
    let lastLang = null;

    function updateSearchFeedback(rawQuery, count, isNearMatches, isTyping = false) {
        const dot = document.getElementById('searchFeedbackDot');
        const textEl = document.getElementById('searchFeedbackText');
        const jumpBtn = document.getElementById('jumpToResultsBtn');
        const jumpLabel = document.getElementById('jumpToResultsLabel');
        if (!textEl || !dot) return;

        const currentLang = window.getLang ? window.getLang() : 'te';
        const isEn = currentLang === 'en';
        const trimmed = (rawQuery || '').trim();

        if (!trimmed) {
            dot.className = 'search-feedback-dot idle';
            textEl.textContent = window.t
                ? window.t('searchFeedbackDefault')
                : (isEn ? 'Type a scheme name or medical condition — results update instantly' : 'పథకం పేరు లేదా సమస్య టైప్ చేయండి — ఫలితాలు తక్షణమే కనిపిస్తాయి');
            if (jumpBtn) jumpBtn.style.display = 'none';
            return;
        }

        if (isTyping) {
            dot.className = 'search-feedback-dot active';
            const typingTemplate = window.t ? window.t('searchFeedbackTyping', { query: window.escapeHtml(trimmed) }) : '';
            textEl.innerHTML = typingTemplate || (isEn
                ? `⚡ Searching for "<strong>${window.escapeHtml(trimmed)}</strong>"...`
                : `⚡ శోధిస్తున్నాం: "<strong>${window.escapeHtml(trimmed)}</strong>"...`);
            return;
        }

        if (count > 0) {
            dot.className = 'search-feedback-dot active';
            if (isNearMatches) {
                const nearTemplate = window.t ? window.t('searchFeedbackNear', { count: count }) : '';
                textEl.innerHTML = nearTemplate || (isEn
                    ? `💡 Closest matching schemes: <strong>${count} found</strong>`
                    : `💡 సరిపోలిన సంబంధిత పథకాలు: <strong>${count} దొరికాయి</strong>`);
            } else {
                const foundTemplate = window.t ? window.t('searchFeedbackFound', { count: count, query: window.escapeHtml(trimmed), s: count === 1 ? '' : 's' }) : '';
                textEl.innerHTML = foundTemplate || (isEn
                    ? `✅ Found <strong>${count} scheme${count === 1 ? '' : 's'}</strong> for "<strong>${window.escapeHtml(trimmed)}</strong>"`
                    : `✅ "<strong>${window.escapeHtml(trimmed)}</strong>" కోసం <strong>${count} పథకాలు</strong> దొరికాయి`);
            }
            if (jumpBtn) {
                jumpBtn.style.display = 'inline-flex';
                if (jumpLabel) {
                    jumpLabel.textContent = isEn ? `View ${count} Results ↓` : `${count} ఫలితాలు చూడండి ↓`;
                }
            }
        } else {
            dot.className = 'search-feedback-dot empty';
            const emptyTemplate = window.t ? window.t('searchFeedbackEmpty', { query: window.escapeHtml(trimmed) }) : '';
            textEl.innerHTML = emptyTemplate || (isEn
                ? `⚠️ No schemes found for "<strong>${window.escapeHtml(trimmed)}</strong>". Try another keyword.`
                : `⚠️ "<strong>${window.escapeHtml(trimmed)}</strong>" కోసం పథకాలు దొరకలేదు. వేరే పదం ప్రయత్నించండి.`);
            if (jumpBtn) jumpBtn.style.display = 'none';
        }
    }
    window.updateSearchFeedback = updateSearchFeedback;

    function renderSchemeCards(force = false) {
        const inputEl = document.getElementById('searchInput');
        const rawQuery = inputEl ? inputEl.value.trim() : '';
        const query = rawQuery.toLowerCase();
        const grid = document.getElementById('schemesGrid');
        const countBadge = document.getElementById('schemeCountBadge');
        if (!grid) return;

        const currentLang = window.getLang ? window.getLang() : 'te';

        if (!force && rawQuery === lastQuery && activeFilter === lastFilter && currentLang === lastLang) {
            return;
        }
        lastQuery = rawQuery;
        lastFilter = activeFilter;
        lastLang = currentLang;

        const searchResult = searchAndRankSchemes(rawQuery, activeFilter);
        const filtered = searchResult.names;
        const isNearMatches = searchResult.isNearMatches;

        const isEn = currentLang === 'en';

        if (countBadge) {
            countBadge.textContent = isNearMatches ? `${filtered.length} (${isEn ? 'Near' : 'సమీప'})` : filtered.length;
        }

        updateSearchFeedback(rawQuery, filtered.length, isNearMatches, false);

        if (filtered.length === 0) {
            const emptyMsg = activeFilter === 'favorites'
                ? (window.t ? window.t('noFavoritesMsg') : 'ఇష్టమైన పథకాలు ఏవీ లేవు. పథకం కార్డుపై ఉన్న ★ నక్షత్రాన్ని నొక్కి ఇష్టమైనదిగా చేర్చుకోండి.')
                : (window.t ? window.t('noSchemesFound') : 'ఎలాంటి పథకాలు దొరకలేదు.');
            grid.innerHTML = `
                <div class="grid-empty-msg" style="text-align: center; padding: 30px 16px; width: 100%; grid-column: 1 / -1;">
                    <div style="font-size: 1.1rem; font-weight: 600; margin-bottom: 12px;">${window.escapeHtml(emptyMsg)}</div>
                    ${query ? `
                        <div style="font-size: 0.9rem; color: var(--muted); margin-bottom: 16px;">
                            ${window.t ? window.t('tryOtherVoiceKeywords') : 'సూచన: "ఆరోగ్యశ్రీ", "కంటి వెలుగు", "డయాలసిస్", "108" వంటి పదాలతో మాట్లాడండి.'}
                        </div>
                        <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 8px;">
                            <button type="button" class="voice-hint-chip" data-action="voice-hint" data-query="ఆరోగ్యశ్రీ">"ఆరోగ్యశ్రీ"</button>
                            <button type="button" class="voice-hint-chip" data-action="voice-hint" data-query="కంటి వెలుగు">"కంటి వెలుగు"</button>
                            <button type="button" class="voice-hint-chip" data-action="voice-hint" data-query="డయాలసిస్">"డయాలసిస్"</button>
                            <button type="button" class="voice-hint-chip" data-action="voice-hint" data-query="104">"104"</button>
                            <button type="button" class="voice-hint-chip" data-action="clear-search-and-show-all">${window.t ? window.t('showAllSchemesBtn') : (isEn ? 'Show All Schemes' : 'అన్ని పథకాలు చూపించు')}</button>
                        </div>
                    ` : ''}
                </div>
            `;
            return;
        }

        let bannerHtml = '';
        if (isNearMatches) {
            const bannerText = window.t
                ? window.t('nearMatchesBanner', { query: window.escapeHtml(rawQuery) })
                : (isEn ? `No exact match for "<strong>${window.escapeHtml(rawQuery)}</strong>". Showing <strong>closest matching government schemes</strong>:` : `"<strong>${window.escapeHtml(rawQuery)}</strong>" కోసం ఖచ్చితమైన సరిపోలిక లేకపోయినా, <strong>సమీప లేదా సంబంధిత పథకాలు</strong> ఇవి:`);
            const btnText = window.t ? window.t('showAllSchemesBtn') : (isEn ? 'Show All Schemes' : 'అన్ని పథకాలు చూపించు');
            bannerHtml = `
                <div class="near-matches-banner" role="status" style="grid-column: 1 / -1; width: 100%;">
                    <div class="near-matches-content">
                        <span class="near-matches-icon" aria-hidden="true">💡</span>
                        <span class="near-matches-text">${bannerText}</span>
                    </div>
                    <button type="button" class="near-matches-clear-btn" data-action="clear-search-and-show-all">${btnText}</button>
                </div>
            `;
        }

        grid.innerHTML = bannerHtml + filtered.map(name => {
            const data = schemesCatalog[name];
            const levelClass = data.level === 'Andhra Pradesh' ? 'level-ap' : 'level-national';
            const levelLabel = window.SmartGovI18n ? window.SmartGovI18n.translateLevel(data.level) : (data.level === 'Andhra Pradesh' ? 'ఆంధ్రప్రదేశ్' : 'జాతీయ');
            const categoryLabel = window.SmartGovI18n ? window.SmartGovI18n.translateCategory(data.category) : (data.category || '');
            const isFavorite = window.SmartGovUX ? window.SmartGovUX.isFavorite(name) : false;
            const primaryTitle = isEn ? name : (data.telugu_name || name);
            const secondaryTitle = isEn ? categoryLabel : name;
            const benefitHighlight = isEn ? (data.benefit_amount || data.coverage_type) : (data.benefit_amount_te || data.benefit_amount || data.coverage_type_te || data.coverage_type);
            const favTitle = window.t ? window.t('favoriteBtnTitle') : 'Favorite';
            const listenLabel = isEn ? 'Listen' : 'వినండి';
            const slidesLabel = isEn ? 'Slides' : 'స్లైడ్లు';
            const detailsLabel = isEn ? 'Details' : 'వివరాలు';
            const cardIcon = iconMap[data.icon] || '🏥';
            const nearBadgeHtml = isNearMatches ? `<span class="near-match-pill">💡 ${isEn ? 'Near Match' : 'సమీప సరిపోలిక'}</span>` : '';
            const vectorMatch = (rawQuery && window.currentVectorSearchResults && window.currentVectorSearchResults[name]) ? window.currentVectorSearchResults[name] : null;
            const vectorBadgeHtml = (rawQuery && vectorMatch && vectorMatch.matchPercent >= 45)
                ? `<span class="vector-match-pill" title="Vector Cosine Similarity: ${vectorMatch.matchPercent}%">⚡ ${vectorMatch.matchPercent}% ${isEn ? 'Match' : 'సరిపోలిక'}</span>`
                : '';

            return `
                <div class="scheme-card" data-action="open-scheme" data-scheme="${window.escapeHtml(name)}" role="button" tabindex="0" aria-label="${window.escapeHtml(primaryTitle)}">
                    <div class="scheme-card-header">
                        <div class="scheme-badges">
                            <span class="level-badge ${levelClass}">${levelLabel}</span>
                            <span class="category-badge"><span class="card-icon" aria-hidden="true">${cardIcon}</span> ${window.escapeHtml(categoryLabel)}</span>
                            ${vectorBadgeHtml}
                            ${nearBadgeHtml}
                        </div>
                        <button type="button" class="favorite-btn ${isFavorite ? 'active' : ''}" data-scheme="${window.escapeHtml(name)}" title="${favTitle}" aria-label="Toggle favorite">
                            ${isFavorite ? '★' : '☆'}
                        </button>
                    </div>
                    <div class="scheme-card-body">
                        <h2 class="scheme-card-title">${window.escapeHtml(primaryTitle)}</h2>
                        <p class="scheme-card-subtitle">${window.escapeHtml(secondaryTitle)}</p>
                        ${benefitHighlight ? `<div class="scheme-card-highlight"><span class="highlight-tag">💰 ${window.escapeHtml(benefitHighlight)}</span></div>` : ''}
                    </div>
                    <div class="scheme-card-actions">
                        <button type="button" class="card-action-btn audio-btn" data-action="listen-scheme" data-scheme="${window.escapeHtml(name)}" title="${listenLabel}">
                            <span>🔊</span> ${listenLabel}
                        </button>
                        <button type="button" class="card-action-btn slides-btn" data-action="open-guided" data-scheme="${window.escapeHtml(name)}" title="${slidesLabel}">
                            <span>🖼️</span> ${slidesLabel}
                        </button>
                        <button type="button" class="card-action-btn details-btn" data-action="open-scheme" data-scheme="${window.escapeHtml(name)}" title="${detailsLabel}">
                            <span>📋</span> ${detailsLabel}
                        </button>
                    </div>
                </div>
            `;
        }).join('');
    }

