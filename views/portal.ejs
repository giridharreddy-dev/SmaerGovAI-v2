                    history: window.chatHistory.slice(-10), // Send conversation turns
                    lang: activeLang,
                    mode: activeChatMode
                })
            });

            typingRow.remove();

            const botReply = data.error || data.response || data.answer || (activeLang === 'en' ? 'I could not find matching scheme information. Please ask another question.' : 'క్షమించండి, తగిన సమాచారం లభించలేదు. దయచేసి మరో ప్రశ్న అడగండి.');
            const matchedSchemes = data.matched_schemes || [];
            const modelUsed = data.model_used || activeChatMode;

            window.chatHistory.push({
                role: 'model',
                text: botReply,
                timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
                model: modelUsed,
                matched_schemes: matchedSchemes
            });
            saveChatHistory();
            renderChatThread();
        } catch (err) {
            typingRow.remove();
            const activeLang = window.getLang ? window.getLang() : 'te';
            const errorMsg = activeLang === 'en' ? 'Network error. Please try again.' : 'నెట్‌వర్క్ లోపం సంభవించింది. దయచేసి మళ్ళీ ప్రయత్నించండి.';
            window.chatHistory.push({
                role: 'model',
                text: errorMsg,
                timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
                model: activeChatMode,
                matched_schemes: []
            });
            saveChatHistory();
            renderChatThread();
        }
    });

    // Initial render of chat thread
    renderChatThread();

    function restoreEligibilityAnswers() {
        document.querySelectorAll('.question-item').forEach(item => {
            const firstBtn = item.querySelector('.yes-no-btn');
            if (!firstBtn) return;
            const idx = firstBtn.dataset.idx;
            const saved = (currentSchemeName ? localStorage.getItem(`eligibility_${currentSchemeName}_q${idx}`) : null) ||
                          localStorage.getItem(`eligibility_q${idx}`);
            if (saved) {
                const buttons = item.querySelectorAll('.yes-no-btn');
                buttons.forEach(btn => {
                    btn.classList.remove('yes', 'no');
                    if ((saved === 'yes' && (btn.textContent.includes('అవును') || btn.textContent.includes('Yes'))) ||
                        (saved === 'no' && (btn.textContent.includes('కాదు') || btn.textContent.includes('No')))) {
                        btn.classList.add(saved);
                    }
                });
            }
        });
    }

    function restoreDocumentChecks() {
        if (currentSchemeName) {
            document.querySelectorAll('.checklist-item input[type="checkbox"]').forEach((checkbox, idx) => {
                const saved = localStorage.getItem(`doc_check_${currentSchemeName}_${idx}`);
                if (saved === 'true') checkbox.checked = true;
            });
        }
    }

    function updateChatUi() {
        const isEn = window.getLang && window.getLang() === 'en';
        const introEl = document.querySelector('#chatMessages .chat-bubble.intro p');
        if (introEl) {
            introEl.textContent = isEn
                ? 'Hello! I am the SmartGovAI Health Assistant. Ask me any question about Andhra Pradesh health schemes, Aarogyasri, maternal care, or free hospital services.'
                : 'నమస్కారం! నేను SmartGovAI ఆరోగ్య సహాయకుడిని. ఆరోగ్యశ్రీ, గర్భిణుల పథకాలు, ఉచిత మందులు లేదా ఆసుపత్రి చికిత్స గురించి మీ ప్రశ్నను అడగండి.';
        }

        const quickContainer = document.querySelector('.chat-quick-questions');
        if (quickContainer) {
            const questions = isEn ? [
                { q: 'Who is eligible for Aarogyasri?', label: 'Aarogyasri eligibility?' },
                { q: 'What schemes are available for pregnant women?', label: 'Pregnancy schemes?' },
                { q: 'Where can I get free medicines?', label: 'Free medicines?' },
                { q: 'What is the child vaccination scheme?', label: 'Child vaccination?' }
            ] : [
                { q: 'ఆరోగ్యశ్రీకి ఎవరు అర్హులు?', label: 'ఆరోగ్యశ్రీ అర్హత?' },
                { q: 'గర్భిణులకు ఏ పథకాలు ఉన్నాయి?', label: 'గర్భిణుల పథకాలు?' },
                { q: 'ఉచిత మందులు ఎక్కడ దొరుకుతాయి?', label: 'ఉచిత మందులు?' },
                { q: 'పిల్లల టీకాల పథకం ఏది?', label: 'పిల్లల టీకాలు?' }
            ];

            quickContainer.innerHTML = questions.map(item =>
                `<button type="button" class="quick-q-btn" data-action="ask-quick" data-q="${window.escapeHtml(item.q)}">${window.escapeHtml(item.label)}</button>`
            ).join('');
        }
    }

    window.closeSchemesDashboardModal = function() {
        const dashboardModal = document.getElementById('schemesDashboardModal');
        if (dashboardModal) {
            if (typeof dashboardModal.close === 'function') {
                dashboardModal.close();
            } else {
                dashboardModal.removeAttribute('open');
            }
        }
    };

    // State Restoration Engine for Browser Back Button and External Link Return
    let isRestoringHistoryState = false;

    function restoreStateFromNavigation(state) {
        if (!state) return;
        isRestoringHistoryState = true;

        if (state.activeFilter && state.activeFilter !== activeFilter) {
            activeFilter = state.activeFilter;
            document.querySelectorAll('.filter-btn').forEach(btn => {
                const isActive = btn.dataset.filter === activeFilter;
                btn.classList.toggle('active', isActive);
                btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
            });
        }
        if (typeof state.searchQuery === 'string') {
            const searchInput = document.getElementById('searchInput');
            if (searchInput && searchInput.value !== state.searchQuery) {
                searchInput.value = state.searchQuery;
                const clearBtn = document.getElementById('clearSearchBtn');
                if (clearBtn) clearBtn.style.display = state.searchQuery ? 'inline-flex' : 'none';
            }
        }
        renderSchemeCards(true);

        if (state.schemeName) {
            const targetScheme = schemesCatalog[state.schemeName];
            if (targetScheme) {
                displayResult(targetScheme, true);
            } else if (typeof window.fetchScheme === 'function') {
                window.fetchScheme(state.schemeName, true);
            }
        }

        if (typeof state.scrollY === 'number' && state.scrollY >= 0) {
            requestAnimationFrame(() => {
                window.scrollTo({ top: state.scrollY, behavior: 'auto' });
                setTimeout(() => {
                    window.scrollTo({ top: state.scrollY, behavior: 'auto' });
                    isRestoringHistoryState = false;
                }, 60);
                setTimeout(() => {
                    window.scrollTo({ top: state.scrollY, behavior: 'auto' });
                }, 200);
            });
        } else {
            isRestoringHistoryState = false;
        }
    }

    let historySyncTimer = null;
    function syncHistoryState() {
        if (isRestoringHistoryState) return;
        if (historySyncTimer) clearTimeout(historySyncTimer);
        historySyncTimer = setTimeout(() => {
            const currentQuery = document.getElementById('searchInput')?.value || '';
            const navState = {
                schemeName: currentSchemeName,
                activeFilter: activeFilter || 'all',
                searchQuery: currentQuery,
                scrollY: window.scrollY
            };
            try {
                const isValidScheme = currentSchemeName && currentSchemeName !== 'undefined';
                const targetHash = isValidScheme ? ('#scheme=' + encodeURIComponent(currentSchemeName)) : (window.location.hash && !window.location.hash.includes('undefined') ? window.location.hash : '');
                history.replaceState(navState, '', targetHash || window.location.pathname);
                sessionStorage.setItem('smartgov_visit_website_state', JSON.stringify(navState));
            } catch (e) {}
        }, 150);
    }
    window.restoreStateFromNavigation = restoreStateFromNavigation;
    window.addEventListener('scroll', syncHistoryState, { passive: true });

    // Capture click on external links / official portal links to open in present-tab iframe
    document.addEventListener('click', (e) => {
        const link = e.target.closest('a');
        if (link && (link.classList.contains('source-link') || (link.href && link.href.startsWith('http') && !link.href.includes(window.location.host)))) {
            // Do not intercept if clicked inside the portal overlay header itself
            if (link.closest('#inAppPortalOverlay')) return;
            e.preventDefault();
            const linkUrl = link.getAttribute('data-portal-url') || link.href;
            const linkTitle = link.getAttribute('data-portal-title') || link.textContent.trim() || 'Official Government Portal';
            if (typeof window.openInAppPortal === 'function') {
                window.openInAppPortal(linkUrl, linkTitle);
            }
        }
    });

    // Handle Browser Back & Forward Navigation (popstate)
    window.addEventListener('popstate', (e) => {
        if (window._isPortalFrameOpen) {
            if (typeof window.closeInAppPortal === 'function') {
                window.closeInAppPortal();
                return;
            }
        }
        if (e.state && (e.state.schemeName || e.state.activeFilter || e.state.searchQuery !== undefined || typeof e.state.scrollY === 'number')) {
            restoreStateFromNavigation(e.state);
        } else if (window.location.hash.startsWith('#scheme=')) {
            const sName = decodeURIComponent(window.location.hash.replace('#scheme=', ''));
            if (sName && schemesCatalog[sName]) {
                displayResult(schemesCatalog[sName], false);
            }
        } else {
            // Restore from session storage if available so we never clear scheme unexpectedly on back
            try {
                const saved = sessionStorage.getItem('smartgov_visit_website_state');
                if (saved) {
                    const parsed = JSON.parse(saved);
                    if (parsed && parsed.schemeName && schemesCatalog[parsed.schemeName]) {
                        restoreStateFromNavigation(parsed);
                        return;
                    }
                }
            } catch (err) {}

            currentSchemeName = null;
            currentSchemeData = null;
            const resultArea = document.getElementById('resultArea');
            if (resultArea) {
                const isEn = (window.getLang ? window.getLang() : 'te') === 'en';
                resultArea.innerHTML = `
                    <div class="empty-state">
                        <div>
                            <strong data-i18n="aboutSchemeTitle">${isEn ? 'Select a scheme' : 'పథకం ఎంచుకోండి'}</strong>
                            <span data-i18n="emptyResultsMsg">${isEn ? 'Select any scheme above to view full benefits and eligibility.' : 'పై జాబితా నుండి ఏదైనా పథకాన్ని ఎంచుకుని పూర్తి వివరాలు చూడండి.'}</span>
                        </div>
                    </div>
                `;
            }
            renderSchemeCards(true);
        }
    });

    // Handle Page Show (restores state when navigating back from external tabs or pages)
    window.addEventListener('pageshow', () => {
        try {
            const saved = sessionStorage.getItem('smartgov_visit_website_state');
            if (saved) {
                const parsed = JSON.parse(saved);
                if (parsed) {
                    restoreStateFromNavigation(parsed);
                }
            }
        } catch (err) {}
    });

    // Auto-open scheme from URL hash, session storage, or parameter
    let initialOpened = false;
    if (window.location.hash.startsWith('#scheme=')) {
        const hashScheme = decodeURIComponent(window.location.hash.replace('#scheme=', ''));
        if (hashScheme && schemesCatalog[hashScheme]) {
            fetchScheme(hashScheme);
            initialOpened = true;
        }
    }
    
    if (!initialOpened) {
        try {
            const savedState = sessionStorage.getItem('smartgov_visit_website_state');
            if (savedState) {
                const parsed = JSON.parse(savedState);
                if (parsed && parsed.schemeName && schemesCatalog[parsed.schemeName]) {
                    restoreStateFromNavigation(parsed);
                    initialOpened = true;
                }
            }
        } catch (e) {}
    }

    const autoOpen = document.body.dataset.autoOpen;
    if (!initialOpened && autoOpen && schemesCatalog[autoOpen]) {
        fetchScheme(autoOpen);
    }

    window.addEventListener('languagechange', () => {
        updateChatUi();
        populateSchemeDropdown();
        renderSchemeCards(true);
        if (currentSchemeName && schemesCatalog[currentSchemeName]) {
            displayResult(schemesCatalog[currentSchemeName], true);
        }
        if (typeof window.mountSchemesDashboard === 'function') {
            const activeLang = window.getLang ? window.getLang() : 'te';
            window.mountSchemesDashboard('schemesDashboardRoot', window.schemesCatalog || {}, activeLang);
        }
    });

    // Initialize initial language states on startup
    updateChatUi();
    if (window.SmartGovI18n) {
        window.SmartGovI18n.applyStaticTranslations();
        const activeLang = window.getLang ? window.getLang() : 'te';
        const teBtn = document.getElementById('langTeBtn');
        const enBtn = document.getElementById('langEnBtn');
        if (teBtn && enBtn) {
            if (activeLang === 'te') {
                teBtn.classList.add('active');
                teBtn.setAttribute('aria-pressed', 'true');
                enBtn.classList.remove('active');
                enBtn.setAttribute('aria-pressed', 'false');
            } else {
                enBtn.classList.add('active');
                enBtn.setAttribute('aria-pressed', 'true');
                teBtn.classList.remove('active');
                teBtn.setAttribute('aria-pressed', 'false');
            }
        }
    }

    populateSchemeDropdown();
    renderSchemeCards();
    setupVoice();
    setupInstallPrompt();

    // Mount Recharts Schemes Analytics Dashboard
    if (typeof window.mountSchemesDashboard === 'function') {
        const activeLang = window.getLang ? window.getLang() : 'te';
        window.mountSchemesDashboard('schemesDashboardRoot', window.schemesCatalog || {}, activeLang);
    }

    // Initialize high-performance progressive batch fetching
    if (window.BatchSchemeLoader) {
        window.BatchSchemeLoader.init();
    }

    if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register("/service-worker.js")
            .then(reg => {
                if (reg.active) {
                    reg.active.postMessage({ type: 'CACHE_ALL_AUDIO' });
                }
            })
            .catch(() => {});
    }

    // Network Connectivity Monitoring & Automatic Background Cache Sync
    function updateNetworkBanner() {
        const banner = document.getElementById('offlineStatusBanner');
        const bannerText = document.getElementById('offlineBannerText');
        if (!banner || !bannerText) return;

        const isEn = (window.getLang ? window.getLang() : 'te') === 'en';

        if (!navigator.onLine) {
            banner.className = 'offline-status-banner';
            bannerText.innerHTML = isEn 
                ? '<strong>You are currently offline.</strong> Displaying cached health scheme data from Service Worker local memory.' 
                : '<strong>మీరు ప్రస్తుతం ఆఫ్‌లైన్‌లో ఉన్నారు.</strong> స్థానికంగా భద్రపరిచిన పథకాల సమాచారాన్ని చూపిస్తున్నాం.';
            banner.style.display = 'flex';
        } else {
            banner.style.display = 'none';
        }
    }

    async function forceSyncOfflineCache() {
        const banner = document.getElementById('offlineStatusBanner');
        const bannerText = document.getElementById('offlineBannerText');
        const refreshBtn = document.getElementById('offlineRefreshBtn');
        const isEn = (window.getLang ? window.getLang() : 'te') === 'en';

        if (refreshBtn) {
            refreshBtn.disabled = true;
            refreshBtn.innerHTML = `⏳ ${isEn ? 'Syncing...' : 'సింక్ అవుతోంది...'}`;
        }

        try {
            // Force fetch latest scheme dataset from server and sync with Firestore local cache
            const resp = await fetch('/offline-cache?force_sync=' + Date.now(), { cache: 'no-store' });
            if (resp.ok) {
                const data = await resp.json();
                if (data && data.schemes_list) {
                    if (window.SmartGovEnhanced) {
                        window.SmartGovEnhanced.saveOfflineData(data);
                    }
                    if (navigator.serviceWorker && navigator.serviceWorker.controller) {
                        navigator.serviceWorker.controller.postMessage({ type: 'CACHE_ALL_AUDIO' });
                    }
                }
                if (banner && bannerText) {
                    banner.className = 'offline-status-banner online-restored';
                    bannerText.innerHTML = isEn
                        ? '✅ <strong>Local cache synced with Firestore successfully!</strong> Fresh data loaded.'
                        : '✅ <strong>సరికొత్త డేటాతో కాష్ సింక్ అయింది!</strong> నవీకరించిన సమాచారం లోడ్ అయింది.';
                }
                setTimeout(() => {
                    if (banner) banner.style.display = 'none';
                }, 3500);
            } else {
                throw new Error('Sync failed');
            }
        } catch (err) {
            if (bannerText) {
                bannerText.innerHTML = isEn
                    ? '⚠️ <strong>Unable to sync with Firestore.</strong> Please check your internet connection and try again.'
                    : '⚠️ <strong>సింక్ చేయడం వీలుకాలేదు.</strong> దయచేసి మీ ఇంటర్నెట్ కనెక్షన్ సరిచూసుకుని మళ్లీ ప్రయత్నించండి.';
            }
        } finally {
            if (refreshBtn) {
                refreshBtn.disabled = false;
                refreshBtn.innerHTML = `🔄 ${isEn ? 'Sync Now' : 'రీఫ్రెష్ & సింక్'}`;
            }
        }
    }

    async function checkNetworkAndSync() {
        if (navigator.onLine) {
            await forceSyncOfflineCache();
        } else {
            updateNetworkBanner();
        }
    }

    window.forceSyncOfflineCache = forceSyncOfflineCache;
    window.checkNetworkAndSync = checkNetworkAndSync;
    window.addEventListener('online', checkNetworkAndSync);
    window.addEventListener('offline', updateNetworkBanner);
</script>
    <script src="/public/js/portal-overlay.js"></script>
    <script src="/public/js/offline-sync.js"></script>
</body>
</html>
