    async function safeFetch(url, options = {}) {
        try {
            const response = await fetch(url, options);
            let data;
            const contentType = response.headers.get('content-type') || '';
            if (contentType.includes('application/json')) {
                data = await response.json();
            } else {
                const text = await response.text();
                data = {
                    status: 'error',
                    error: response.ok
                        ? 'Unexpected response format'
                        : (window.t ? window.t('serverError') : 'సర్వర్ లోపం. దయచేసి మళ్ళీ ప్రయత్నించండి.'),
                    error_code: 'NON_JSON_RESPONSE',
                    response_text: text
                };
            }
            if (!response.ok && !data.error) {
                data.error = window.t ? window.t('serverError') : 'సర్వర్ లోపం. దయచేసి మళ్ళీ ప్రయత్నించండి.';
            }
            return data;
        } catch (error) {
            throw error;
        }
    }

    window.fetchScheme = async function fetchScheme(schemeName, preventScroll = false) {
        if (!schemeName) return;

        let recentCached = null;
        try {
            const storedRecent = JSON.parse(localStorage.getItem('smartgov_recent_schemes') || '{}');
            recentCached = storedRecent[schemeName];
        } catch(e){}

        // 1. Instant local render if available in catalog or local cache (0ms latency)
        const localData = (schemesCatalog && schemesCatalog[schemeName]) ||
                          (window.SmartGovEnhanced?.loadOfflineData()?.schemes_list?.[schemeName]) ||
                          recentCached;

        if (localData) {
            displayResult(localData, preventScroll);
            // Async non-blocking background server request for telemetry/logging
            safeFetch("/simplify", {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRFToken': csrfToken
                },
                body: JSON.stringify({ scheme_name: schemeName })
            }).catch(() => {});
            return;
        }

        // 2. Fallback to server fetch if not present in memory
        showLoading();
        const detailSection = document.getElementById('schemeDetail') || document.getElementById('resultArea');
        if (!preventScroll && detailSection) {
            detailSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        try {
            const data = await safeFetch("/simplify", {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRFToken': csrfToken
                },
                body: JSON.stringify({ scheme_name: schemeName })
            });
            displayResult(data, preventScroll);
            if (!preventScroll && detailSection) {
                detailSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        } catch (error) {
            const offlineData = window.SmartGovEnhanced?.loadOfflineData();
            const cachedScheme = offlineData?.schemes_list?.[schemeName];
            if (cachedScheme) {
                displayResult({
                    request_id: null,
                    scheme_name: schemeName,
                    level: 'Cached copy',
                    category: cachedScheme.category || '',
                    source_name: 'Cached SmartGovAI data',
                    source_url: '',
                    simplified: cachedScheme.simplified,
                    telugu: cachedScheme.telugu,
                    voice_url: cachedScheme.voice_url
                }, preventScroll);
                if (!preventScroll && detailSection) {
                    detailSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
                return;
            }
            showError(window.t ? window.t('networkError', { error: error.message }) : `నెట్ వర్క్ లోపం: ${error.message}`);
        }
    };

    async function sendAccuracyFeedback(rating, tags = [], comment = '', schemeName = '') {
        const reqId = currentRequestId || (schemeName ? 'scheme_' + encodeURIComponent(schemeName) : 'anon_' + Date.now());
        const status = document.getElementById('feedbackStatus');
        const isEn = (window.getLang ? window.getLang() : 'te') === 'en';

        if (status) status.textContent = isEn ? 'Saving feedback...' : 'సేవ్ చేస్తున్నాం...';
        try {
            const combinedComment = [
                tags.length ? `[Tags: ${tags.join(', ')}]` : '',
                comment ? comment.trim() : ''
            ].filter(Boolean).join(' ');

            const data = await safeFetch("/enhanced-feedback", {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRFToken': csrfToken
                },
                body: JSON.stringify({ 
                    request_id: reqId, 
                    scheme_name: schemeName || currentSchemeName || '',
                    rating: Number(rating),
                    feedback_text: combinedComment || 'AI Simplification accuracy rating',
                    issue_type: 'accuracy_rating'
                })
            });

            if (status) {
                status.style.color = '#15803d';
                status.textContent = isEn ? '✅ Thank you! Your accuracy rating has been recorded.' : '✅ ధన్యవాదాలు! మీ విశ్లేషణ రేటింగ్ సేవ్ చేయబడింది.';
            }
            if (typeof window.showToast === 'function') {
                window.showToast(isEn ? '✅ Thank you! Your feedback has been recorded.' : '✅ ధన్యవాదాలు! మీ స్పందన నమోదు చేయబడింది.', 'success');
            }
        } catch (error) {
            if (status) {
                status.style.color = '#dc2626';
                status.textContent = isEn ? `Error: ${error.message}` : `లోపం: ${error.message}`;
            }
            if (typeof window.showToast === 'function') {
                window.showToast(error.message, 'error');
            }
        }
    }

    function populateSchemeDropdown(lang) {
        const select = document.getElementById('schemeSelect');
        if (!select) return;
        const currentVal = select.value;
        const l = lang || (window.getLang ? window.getLang() : 'te');
        const isEn = l === 'en';
        const placeholder = window.t ? window.t('selectDropdownPlaceholder') : (isEn ? '-- Select Scheme --' : '-- ఎంచుకోండి --');

        let html = `<option value="">${window.escapeHtml(placeholder)}</option>`;
        schemeNames.slice().sort().forEach(scheme => {
            const data = schemesCatalog[scheme] || {};
            const label = isEn ? scheme : `${data.telugu_name || scheme} | ${scheme}`;
            const selected = scheme === currentVal ? 'selected' : '';
            html += `<option value="${window.escapeHtml(scheme)}" ${selected}>${window.escapeHtml(label)}</option>`;
        });
        select.innerHTML = html;
    }

    function formatBytes(bytes) {
        if (!bytes || bytes === 0) return '0 B';
        const k = 1024;
        const sizes = ['B', 'KB', 'MB', 'GB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
    }

