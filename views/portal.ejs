    // Markdown Parser for AI Responses
    function parseChatMarkdown(text) {
        if (!text) return '';
        const lines = text.split('\n');
        let html = '';
        let inList = false;
        let listType = '';

        for (let i = 0; i < lines.length; i++) {
            let line = lines[i].trim();
            if (!line) {
                if (inList) {
                    html += listType === 'ul' ? '</ul>' : '</ol>';
                    inList = false;
                }
                continue;
            }

            // Bullet list (*, -, •)
            const bulletMatch = line.match(/^[\*\-•]\s+(.*)$/);
            // Numbered list (1., 2.)
            const numMatch = line.match(/^(\d+)[\.\)]\s+(.*)$/);

            if (bulletMatch) {
                if (!inList || listType !== 'ul') {
                    if (inList) html += listType === 'ul' ? '</ul>' : '</ol>';
                    html += '<ul class="chat-bullet-list">';
                    inList = true;
                    listType = 'ul';
                }
                html += `<li>${formatInlineChatMd(bulletMatch[1])}</li>`;
                continue;
            }

            if (numMatch) {
                if (!inList || listType !== 'ol') {
                    if (inList) html += listType === 'ul' ? '</ul>' : '</ol>';
                    html += '<ol class="chat-ordered-list">';
                    inList = true;
                    listType = 'ol';
                }
                html += `<li>${formatInlineChatMd(numMatch[2])}</li>`;
                continue;
            }

            if (inList) {
                html += listType === 'ul' ? '</ul>' : '</ol>';
                inList = false;
            }

            // Headings
            if (line.startsWith('### ')) {
                html += `<h4 class="chat-heading">${formatInlineChatMd(line.slice(4))}</h4>`;
            } else if (line.startsWith('## ')) {
                html += `<h3 class="chat-heading">${formatInlineChatMd(line.slice(3))}</h3>`;
            } else if (line.startsWith('# ')) {
                html += `<h2 class="chat-heading">${formatInlineChatMd(line.slice(2))}</h2>`;
            } else {
                html += `<p class="chat-para">${formatInlineChatMd(line)}</p>`;
            }
        }

        if (inList) {
            html += listType === 'ul' ? '</ul>' : '</ol>';
        }

        return html;
    }

    function formatInlineChatMd(text) {
        if (!text) return '';
        let escaped = window.escapeHtml ? window.escapeHtml(text) : text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
        escaped = escaped.replace(/\*\*(.+?)\*\*/g, '<strong class="chat-bold">$1</strong>');
        escaped = escaped.replace(/__(.+?)__/g, '<strong class="chat-bold">$1</strong>');
        escaped = escaped.replace(/(^|[^\*])\*([^\*]+?)\*([^\*]|$)/g, '$1<em>$2</em>$3');
        escaped = escaped.replace(/`([^`]+)`/g, '<code class="chat-code">$1</code>');
        return escaped;
    }

