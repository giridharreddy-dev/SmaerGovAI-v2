            const botReply = data.response || data.answer || (activeLang === 'en' ? 'I could not find matching scheme information. Please ask another question.' : 'క్షమించండి, తగిన సమాచారం లభించలేదు. దయచేసి మరో ప్రశ్న అడగండి.');
