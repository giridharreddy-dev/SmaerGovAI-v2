                    <span class="chat-model-badge">✨ AI Grounded</span>
                </div>
                <div class="chat-bubble bot intro">
                    <p class="chat-para">${window.t ? window.t('chatWelcome') : (isEn ? 'Hello! I am SmartGovAI Healthcare Advisor. Ask me anything about AP health schemes in Telugu or English.' : 'నమస్కారం! నేను SmartGovAI అధికారిక ఆరోగ్య సహాయకుడిని. ఆరోగ్యశ్రీ ₹25 లక్షల ఉచిత చికిత్స, గర్భిణుల పథకాలు, ఉచిత మందులు లేదా ఆసుపత్రి సహాయం గురించి మీ ప్రశ్నను అడగండి.')}</p>
                    <p class="chat-em">${window.t ? window.t('chatDisclaimer') : '⚠️ AI responses are for guidance only.'}</p>
                </div>
            `;
            container.appendChild(introRow);
            return;
        }

        window.chatHistory.forEach((turn, idx) => {
            const row = document.createElement('div');
            row.className = `chat-message-row ${turn.role === 'user' ? 'user' : 'bot'}`;
            
            if (turn.role === 'user') {
                row.innerHTML = `
                    <div class="chat-message-meta">
                        <span class="chat-sender-name">${isEn ? 'You' : 'మీరు'}</span>
                        <span class="chat-time">${turn.timestamp || ''}</span>
                    </div>
                    <div class="chat-bubble user">
                        ${window.escapeHtml(turn.text).replace(/\n/g, '<br>')}
                    </div>
                `;
            } else {
                const modelBadge = getModelBadgeLabel(turn.model || activeChatMode);
                let matchedSchemesHtml = '';
                if (turn.matched_schemes && turn.matched_schemes.length > 0) {
                    matchedSchemesHtml = turn.matched_schemes.map(s => `
                        <button type="button" class="chat-matched-scheme-btn" data-action="open-scheme-from-chat" data-scheme="${window.escapeHtml(s)}">
                            🏥 ${window.escapeHtml(s)}
                        </button>
                    `).join('');
                }

                row.innerHTML = `
                    <div class="chat-message-meta">
                        <span class="chat-sender-name">🤖 SmartGovAI</span>
                        <span class="chat-model-badge">${modelBadge}</span>
                        <span class="chat-time">${turn.timestamp || ''}</span>
                    </div>
                    <div class="chat-bubble bot">
                        ${parseChatMarkdown(turn.text)}
                        <div class="chat-bubble-actions">
                            <button type="button" class="chat-bubble-action-btn" data-action="speak-chat-msg" data-msg-idx="${idx}" title="వినండి (Listen)">
                                🔊 <span class="action-label">${window.t ? window.t('chatSpeakBtn') : 'వినండి'}</span>
                            </button>
                            <button type="button" class="chat-bubble-action-btn" data-action="copy-chat-msg" data-msg-idx="${idx}" title="కాపీ చేయండి (Copy)">
                                📋 <span class="action-label">${window.t ? window.t('chatCopyBtn') : 'కాపీ'}</span>
                            </button>
                            ${matchedSchemesHtml}
                        </div>
                    </div>
                `;
            }
            container.appendChild(row);
        });

        container.scrollTop = container.scrollHeight;
    }

