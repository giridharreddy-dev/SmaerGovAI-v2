<!DOCTYPE html>
<html lang="te">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <meta name="theme-color" content="#176b5b">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="description" content="Andhra Pradesh government health schemes lookup, AI assistant, and document simplification platform.">
    <meta name="csrf-token" content="<%= csrf_token %>">
    <title>SmartGov Health | Andhra Pradesh Schemes</title>
    
    <!-- PWA Manifest & Icons -->
    <link rel="manifest" href="/static/manifest.webmanifest">
    <link rel="icon" type="image/svg+xml" href="/static/icon.svg">
    <!-- Leaflet CSS for Health Map -->
    <link rel="stylesheet" href="/static/leaflet/leaflet.css">
    
    <link rel="stylesheet" href="/static/style.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Noto+Sans+Telugu:wght@400;600;700;800&display=swap" rel="stylesheet">
</head>
<body <% if (auto_open_scheme) { %>data-auto-open="<%= auto_open_scheme %>"<% } %>>
    <a href="#mainContent" class="skip-link">Skip to main content / ప్రధాన విషయానికి వెళ్లండి</a>
    <div class="app-shell">
        <header class="hero">
            <div class="hero-header-top">
                <div class="hero-brand-block">
                    <img src="/static/icon.svg" alt="SmartGov Health Guide" class="hero-brand-logo" width="56" height="56">
                    <div class="hero-brand-text">
                        <div class="hero-top-badge-row">
                            <span class="badge" data-i18n="heroBadge">పౌర సమాచార వేదిక • ప్రజా ఆరోగ్యం</span>
                            <span class="hero-sub" data-i18n="heroSub">గ్రామీణ, వయోవృద్ధుల సులభ మార్గదర్శి</span>
                        </div>
                        <h1 data-i18n="appTitle">ఆరోగ్య పథకాల సహాయకం</h1>
                    </div>
                </div>
                <div class="header-controls">
                    <div class="lang-toggle-wrap">
                        <span class="lang-label" data-i18n="langLabel">భాష:</span>
                        <div class="lang-buttons" role="group" aria-label="Language selection">
                            <button type="button" class="lang-btn active" id="langTeBtn" data-action="set-lang" data-lang="te" aria-pressed="true">తెలుగు</button>
                            <button type="button" class="lang-btn" id="langEnBtn" data-action="set-lang" data-lang="en" aria-pressed="false">English</button>
                        </div>
                    </div>
                    <div class="header-right-actions">
                        <div class="font-size-toggle-wrap" title="అక్షరాల పరిమాణం / Text Size" aria-label="Adjust font size">
                            <span class="font-label" data-i18n="fontSizeLabel">అక్షరాలు:</span>
                            <div class="font-buttons" role="group" aria-label="Font size controls">
                                <button type="button" class="font-btn" id="fontDecBtn" data-action="decrease-font" title="చిన్న అక్షరాలు (A-) / Small text" aria-label="Small text">A-</button>
                                <button type="button" class="font-btn" id="fontResetBtn" data-action="reset-font" title="సాధారణ అక్షరాలు (A) / Normal text" aria-label="Normal text">A</button>
                                <button type="button" class="font-btn" id="fontIncBtn" data-action="increase-font" title="పెద్ద అక్షరాలు (A+) / Large text" aria-label="Large text">A+</button>
                            </div>
                        </div>
                        <button type="button" class="contrast-btn" id="contrastBtn" data-action="toggle-contrast" title="Theme Mode / థీమ్ మార్చండి" aria-label="Toggle light, dark, and high contrast theme">
                            <span class="contrast-icon" aria-hidden="true">🌓</span>
                            <span class="contrast-text" data-i18n="contrastBtn">కాంట్రాస్ట్</span>
                        </button>
                        <button type="button" class="install-app-btn" id="installAppBtn" data-action="install-app" style="display:none;" title="Install App / యాప్ ఇన్‌స్టాల్ చేయండి">
                            <span aria-hidden="true">📲</span>
                            <span data-i18n="installAppBtn">ఇన్‌స్టాల్</span>
                        </button>
                    </div>
                </div>
            </div>
            <p class="hero-lead-subtitle" data-i18n="appSubtitle">మీకు వర్తించే ఉచిత వైద్యం, మందులు మరియు ప్రభుత్వ పథకాలను సులభంగా తెలుసుకోండి.</p>
        </header>

        <section class="assistant-bar" aria-label="AI Assistant, Slideshow, and Map Tools">
            <div class="assistant-bar-inner">
                <button type="button" class="assistant-trigger-btn primary" data-action="open-chat">
                    <span class="assistant-icon" aria-hidden="true">🤖</span>
                    <span class="assistant-text">
                        <strong data-i18n="aiAssistantTitle">AI సహాయకుడిని అడగండి</strong>
                        <small data-i18n="aiAssistantSub">పథకాలపై మీ ప్రశ్నలకు తక్షణ సమాధానాలు</small>
                    </span>
                </button>
                <button type="button" class="assistant-trigger-btn slides-trigger-btn" data-action="start-guided-mode">
                    <span class="assistant-icon" aria-hidden="true">🖼️</span>
                    <span class="assistant-text">
                        <strong data-i18n="guidedModeTitle">పథకాల స్లైడ్లు (దశలవారీగా)</strong>
                        <small data-i18n="guidedModeSub">ఒక్కొక్కటిగా సులభంగా అర్థం చేసుకోండి</small>
                    </span>
                </button>
                <button type="button" class="assistant-trigger-btn map-btn" data-action="open-map">
                    <span class="assistant-icon" aria-hidden="true">🗺️</span>
                    <span class="assistant-text">
                        <strong data-i18n="mapTitle">సమీప ఆసుపత్రులు & PHC మ్యాప్</strong>
                        <small data-i18n="mapSub">AP వ్యాప్తంగా ఆరోగ్య కేంద్రాలు</small>
                    </span>
                </button>
                <button type="button" class="assistant-trigger-btn emergency-btn" data-action="open-emergency">
                    <span class="assistant-icon" aria-hidden="true">🚨</span>
                    <span class="assistant-text">
                        <strong data-i18n="emergencyTitle">అత్యవసర హెల్ప్‌లైన్లు</strong>
                        <small data-i18n="emergencySub">108 • 104 • 102 ఉచిత నంబర్లు</small>
                    </span>
                </button>
            </div>
        </section>

        <!-- Emergency Helplines Modal -->
        <dialog id="emergencyModal" class="app-dialog emergency-dialog" aria-labelledby="emergencyHeading">
            <div class="dialog-header">
                <h2 id="emergencyHeading">🚨 అత్యవసర హెల్ప్‌లైన్లు (Emergency Helplines)</h2>
                <button type="button" class="dialog-close-btn" data-action="close-emergency" aria-label="Close">✕</button>
            </div>
            <div class="dialog-body">
                <div class="emergency-cards-grid">
                    <a href="tel:108" class="emergency-card red">
                        <span class="emergency-number">108</span>
                        <strong data-i18n="helpline108Title">అత్యవసర అంబులెన్స్</strong>
                        <small data-i18n="helpline108Sub">ఉచిత 24/7 అత్యవసర సర్వీస్</small>
                    </a>
                    <a href="tel:104" class="emergency-card blue">
                        <span class="emergency-number">104</span>
                        <strong data-i18n="helpline104Title">వైద్య సమాచార కేంద్రం</strong>
                        <small data-i18n="helpline104Sub">ఆరోగ్య సలహాలు, పథకాల వివరాలు</small>
                    </a>
                    <a href="tel:102" class="emergency-card green">
                        <span class="emergency-number">102</span>
                        <strong data-i18n="helpline102Title">తల్లీ-బిడ్డ ఎక్స్‌ప్రెస్</strong>
                        <small data-i18n="helpline102Sub">గర్భిణులు & బాలింతల వాహనం</small>
                    </a>
                    <a href="tel:181" class="emergency-card purple">
                        <span class="emergency-number">181</span>
                        <strong data-i18n="helpline181Title">మహిళా హెల్ప్‌లైన్</strong>
                        <small data-i18n="helpline181Sub">మహిళల రక్షణ & సహాయం</small>
                    </a>
                </div>
                <div class="emergency-footer">
                    <p data-i18n="emergencyNote">ఈ నంబర్లన్నీ ఉచితం (Toll-Free). ఏదైనా ఫోన్ నుండి డయల్ చేయవచ్చు.</p>
                </div>
            </div>
        </dialog>

        <!-- Multi-Turn Chat Modal with Gemini Roles & Voice Input -->
        <dialog id="chatModal" class="app-dialog chat-dialog" aria-labelledby="chatHeading">
            <div class="dialog-header chat-header">
                <div class="chat-header-title">
                    <span class="chat-header-avatar" aria-hidden="true">🤖</span>
                    <div>
                        <div class="chat-title-row">
                            <h2 id="chatHeading" data-i18n="chatModalTitle">SmartGovAI ఆరోగ్య సహాయకుడు</h2>
                            <span class="chat-online-badge" title="AI Service Online"><span class="pulse-dot"></span> <span data-i18n="chatStatusOnline">AI ఆన్‌లైన్</span></span>
                        </div>
                        <small class="chat-subtitle" data-i18n="chatModalSub">ఆంధ్రప్రదేశ్ & జాతీయ ఆరోగ్య పథకాల సలహాదారు</small>
                    </div>
                </div>
                <div class="chat-header-actions">
                    <button type="button" class="chat-header-action-btn" id="clearChatBtn" data-action="clear-chat" title="సంభాషణను క్లియర్ చేయండి (Clear Conversation)">
                        <span aria-hidden="true">🗑️</span>
                        <span class="clear-text" data-i18n="clearChatBtn">కొత్త చాట్</span>
                    </button>
                    <button type="button" class="dialog-close-btn" data-action="close-chat" aria-label="Close">✕</button>
                </div>
            </div>

            <!-- Model Selection Bar -->
            <div class="chat-model-selector" role="radiogroup" aria-label="Gemini Model Selector">
                <span class="model-select-label" data-i18n="chatModelLabel">AI మోడ్:</span>
                <div class="model-chips-group">
                    <button type="button" class="model-chip" data-mode="fast" role="radio" aria-checked="false" title="వేగవంతమైన సమాధానాలు (Gemini 3.1 Flash Lite)">
                        <span class="mode-icon">⚡</span>
                        <span data-i18n="modeFast">వేగవంతం (Flash Lite)</span>
                    </button>
                    <button type="button" class="model-chip active" data-mode="general" role="radio" aria-checked="true" title="సమతుల్య సమాధానాలు (Gemini 3.5 Flash)">
                        <span class="mode-icon">🧠</span>
                        <span data-i18n="modeGeneral">సాధారణం (3.5 Flash)</span>
                    </button>
                    <button type="button" class="model-chip" data-mode="complex" role="radio" aria-checked="false" title="లోతైన విశ్లేషణ (Gemini 3.1 Pro Preview)">
                        <span class="mode-icon">🔬</span>
                        <span data-i18n="modeComplex">సమగ్రం (Pro Preview)</span>
                    </button>
                </div>
            </div>

            <!-- Scrollable Message Thread -->
            <div class="chat-messages" id="chatMessages" role="log" aria-live="polite">
                <!-- Messages populated via JS -->
            </div>

            <!-- Contextual Quick Prompt Chips -->
            <div class="chat-quick-questions" id="chatQuickQuestions">
                <span class="quick-prompt-label" data-i18n="chatQuickPromptLabel">సూచనలు:</span>
                <button type="button" class="quick-q-btn" data-action="ask-quick" data-q="ఆరోగ్యశ్రీ ₹25 లక్షల ఉచిత చికిత్స వివరాలు ఏమిటి?">ఆరోగ్యశ్రీ ₹25 లక్షలు?</button>
                <button type="button" class="quick-q-btn" data-action="ask-quick" data-q="గర్భిణీ స్త్రీలకు ఏ ప్రభుత్వ పథకాలు మరియు ఆర్థిక సహాయం అందుబాటులో ఉన్నాయి?">గర్భిణుల ఆర్థిక సహాయం?</button>
                <button type="button" class="quick-q-btn" data-action="ask-quick" data-q="ఉచిత మందులు మరియు రక్త పరీక్షలు ఎక్కడ లభిస్తాయి?">ఉచిత మందులు & పరీక్షలు?</button>
                <button type="button" class="quick-q-btn" data-action="ask-quick" data-q="ఆరోగ్యశ్రీ కార్డు కోసం ఏ పత్రాలు (Documents) అవసరం?">కావలసిన పత్రాలు?</button>
                <button type="button" class="quick-q-btn" data-action="ask-quick" data-q="ఆరోగ్య ఆసరా శస్త్రచికిత్స అనంతర భత్యం ఎలా పొందాలి?">ఆరోగ్య ఆసరా భత్యం?</button>
            </div>

            <!-- Chat Input Bar with Text + Voice Input -->
            <form class="chat-input-bar" id="chatForm">
                <button type="button" class="chat-mic-btn" id="chatVoiceBtn" title="వాయిస్ ద్వారా అడగండి (Speak in Telugu/English)" aria-label="Speak query">
                    <span class="mic-icon" aria-hidden="true">🎤</span>
                </button>
                <input type="text" id="chatInput" placeholder="మీ ప్రశ్నను ఇక్కడ అడగండి (ఉదా: ఆరోగ్యశ్రీ కార్డు ఎలా పొందాలి?)..." data-i18n-placeholder="chatInputPlaceholder" autocomplete="off" maxlength="400" required>
                <button type="submit" class="chat-send-btn" id="chatSendBtn" aria-label="Send message" title="సందేశం పంపండి">
                    <span class="send-icon" aria-hidden="true">➤</span>
                </button>
            </form>
        </dialog>

        <section id="mainContent" class="search-panel" aria-label="Search and filter schemes">
            <div class="search-panel-header">
                <h2 class="search-panel-title" data-i18n="searchSectionTitle">🔍 పథకాల శోధన & ఫిల్టర్లు</h2>
                <p class="search-panel-sub" data-i18n="searchSectionSub">పథకం పేరు, వ్యాధి లేదా కీవర్డ్ ద్వారా వెతకండి</p>
            </div>

            <div class="search-wrap">
                <label for="searchInput" class="sr-only" data-i18n="searchPlaceholder">పథకం పేరు లేదా సమస్య రాయండి...</label>
                <input
                    id="searchInput"
                    type="text"
                    placeholder="పథకం పేరు లేదా సమస్య రాయండి..."
                    data-i18n-placeholder="searchPlaceholder"
                    autocomplete="off"
                    maxlength="100"
                >
                <button
                    id="voiceBtn"
                    class="voice-btn"
                    type="button"
                    title="వాయిస్ ద్వారా వెతకండి"
                    aria-label="వాయిస్ ద్వారా వెతకండి"
                >
                    🎤
                </button>
            </div>
            <div id="voiceStatus" class="voice-status" aria-live="polite"></div>

            <!-- Recent Searches Section (Local State Tracking) -->
            <div id="recentSearchesSection" class="recent-searches-section" style="display:none;" aria-label="Recent Searches">
                <div class="recent-searches-header">
                    <div class="recent-searches-title-wrap">
                        <span class="recent-searches-icon" aria-hidden="true">🕒</span>
                        <span class="recent-searches-title" data-i18n="recentSearchesTitle">ఇటీవల వెతికినవి</span>
                    </div>
                    <button type="button" class="clear-recent-btn" data-action="clear-recent-searches" data-i18n-title="clearRecentSearchesTitle" title="శోధన చరిత్రను తొలగించండి">
                        <span aria-hidden="true">🗑️</span> <span data-i18n="clearRecentSearches">అన్నీ తుడిచివేయి</span>
                    </button>
                </div>
                <div id="recentSearchesList" class="recent-searches-list" role="list">
                    <!-- Dynamic Recent Search Chips -->
                </div>
            </div>

            <!-- Symptom / Need Finder Panel -->
            <div class="symptom-finder-section" aria-label="Need Finder">
                <details class="symptom-finder-details">
                    <summary data-i18n="symptomFinderSummary">🎯 మీ అవసరం / సమస్య ఆధారంగా పథకం కనుగొనండి</summary>
                    <div class="symptom-chips-grid">
                        <button type="button" class="symptom-chip" data-action="filter-keyword" data-kw="hospital" data-i18n="symptomChipHospital">🏥 ఆసుపత్రిలో చేరడం / శస్త్రచికిత్స</button>
                        <button type="button" class="symptom-chip" data-action="filter-keyword" data-kw="pregnancy" data-i18n="symptomChipPregnancy">🤰 గర్భం / ప్రసవం / బాలింత</button>
                        <button type="button" class="symptom-chip" data-action="filter-keyword" data-kw="children" data-i18n="symptomChipChildren">👶 పిల్లల ఆరోగ్యం / టీకాలు</button>
                        <button type="button" class="symptom-chip" data-action="filter-keyword" data-kw="elderly" data-i18n="symptomChipElderly">👴 వృద్ధాప్య చికిత్స / సంరక్షణ</button>
                        <button type="button" class="symptom-chip" data-action="filter-keyword" data-kw="medicines" data-i18n="symptomChipMedicines">💊 ఉచిత మందులు / క్లినిక్</button>
                        <button type="button" class="symptom-chip" data-action="filter-keyword" data-kw="emergency" data-i18n="symptomChipEmergency">🚑 అత్యవసర రవాణా (108/104)</button>
                        <button type="button" class="symptom-chip" data-action="filter-keyword" data-kw="kidney" data-i18n="symptomChipKidney">🧬 డయాలసిస్ / దీర్ఘకాలిక వ్యాధి</button>
                        <button type="button" class="symptom-chip" data-action="filter-keyword" data-kw="tb" data-i18n="symptomChipTb">🫁 క్షయ (TB) చికిత్స & పోషణ</button>
                    </div>
                </details>
            </div>

            <div class="filter-row">
                <span class="filter-label" data-i18n="filterLabel">ఫిల్టర్:</span>
                <div class="filter-buttons">
                    <button type="button" class="filter-btn active" data-action="set-filter" data-filter="all" data-i18n="filterAll" aria-pressed="true">అన్నీ</button>
                    <button type="button" class="filter-btn" data-action="set-filter" data-filter="ap" data-i18n="filterAP" aria-pressed="false">ఆంధ్రప్రదేశ్</button>
                    <button type="button" class="filter-btn" data-action="set-filter" data-filter="national" data-i18n="filterNational" aria-pressed="false">జాతీయ</button>
                    <button type="button" class="filter-btn favorites-btn" data-action="set-filter" data-filter="favorites" data-i18n="filterFavorites" aria-pressed="false">★ ఇష్టమైనవి</button>
                </div>
            </div>

            <!-- Schemes Cards Grid View -->
            <div class="schemes-grid-section">
                <div class="grid-header">
                    <h2 data-i18n="availableSchemesTitle">అందుబాటులో ఉన్న ఆరోగ్య పథకాలు</h2>
                    <span id="schemeCountBadge" class="count-badge">0</span>
                </div>
                <div id="schemesGrid" class="schemes-grid" role="region" aria-label="Schemes Grid">
                    <!-- Dynamic Scheme Cards Injected Here -->
                </div>
            </div>

