        const currentVal = select.value;
        const l = lang || (window.getLang ? window.getLang() : 'te');
        const isEn = l === 'en';
        const placeholder = window.t ? window.t('selectDropdownPlaceholder') : (isEn ? '-- Select Scheme --' : '-- ఎంచుకోండి --');

        let html = `<option value="">${window.escapeHtml(placeholder)}</option>`;
        schemeNames.slice().sort().forEach(scheme => {
            const data = schemesCatalog[scheme] || {};
            const label = isEn ? scheme : `${data.telugu_name || scheme} | ${scheme}`;
            const selected = scheme === currentVal ? 'selected' : '';
            html += `<option value="${window.escapeHtml(scheme)}" ${selected}>${window.escapeHtml(label)}</option>`;
        });
        select.innerHTML = html;
    }

    async function handleUpload() {
        if (!navigator.onLine) {
            showError(window.t ? window.t('pdfOfflineAlert') : '🌐 ఇంటర్నెట్ కనెక్షన్ అవసరం: కొత్త PDF / ఇమేజ్ పత్రాలను AI ద్వారా విశ్లేషించడానికి ఇంటర్నెట్ కనెక్షన్ అవసరం. మిగతా అన్ని పథకాల వివరాలు, ఆడియో మరియు అర్హత పరీక్షలు ఆఫ్‌లైన్‌లో పూర్తిగా పనిచేస్తాయి.');
            return;
        }

        const file = document.getElementById('pdfUpload').files[0];
        if (!file) {
            showError(window.t ? window.t('selectPdfError') : 'దయచేసి PDF లేదా ఇమేజ్ ఫైల్ ఎంచుకోండి.');
            return;
        }

        // 10MB File Size Limit Check
        const MAX_FILE_SIZE = 10 * 1024 * 1024;
        if (file.size > MAX_FILE_SIZE) {
            showError(window.t ? window.t('fileTooLargeError') : 'ఫైల్ పరిమాణం 10MB కంటే ఎక్కువగా ఉంది. దయచేసి 10MB లోపు ఉన్న PDF లేదా ఇమేజ్ ఫైల్‌ను ఎంచుకోండి.');
            return;
        }

        const consentCheckbox = document.getElementById('pdfConsent');
        if (!consentCheckbox || !consentCheckbox.checked) {
            showError(window.t ? window.t('pdfConsent') : 'దయచేసి పత్రం అప్‌లోడ్ చేయడానికి ముందు గోప్యతా అంగీకారం చెక్‌బాక్స్ ను టిక్ చేయండి.');
            return;
        }

        const isImageFile = file.type.startsWith('image/');
        showLoading(window.t ? (isImageFile ? 'ఇమేజ్ పత్రం చదువుతున్నాం (OCR)...' : window.t('loadingPdf')) : 'పత్రం సరళీకరిస్తున్నాం...');
        const resultArea = document.getElementById('resultArea');
        const stages = [
            isImageFile ? "స్కాన్ చేసిన అక్షరాలను గుర్తిస్తున్నాం (OCR in progress...)" : "పత్రం చదువుతున్నాం... (Reading document...)",
            "ముఖ్యమైన పథక వివరాలు వెతుకుతున్నాం... (Extracting details...)",
            "తెలుగులోకి మారుస్తున్నాం... (Translating to Telugu...)",
            "ఆడియో మరియు కార్డు సిద్ధం చేస్తున్నాం... (Preparing results...)"
        ];
        let stageIndex = 0;
        const progressInterval = setInterval(() => {
            const loader = resultArea.querySelector('.loading');
            if (loader && stageIndex < stages.length) {
                loader.textContent = stages[stageIndex];
                stageIndex++;
            }
        }, 2000);

        const formData = new FormData();
        formData.append('document', file);
        formData.append('consent', 'true');
        try {
            const data = await safeFetch("/simplify", {
                method: 'POST',
                headers: {
                    'X-CSRFToken': csrfToken
                },
                body: formData
            });
            clearInterval(progressInterval);
            displayResult(data);
        } catch (error) {
            clearInterval(progressInterval);
            showError(window.t ? window.t('networkError', { error: error.message }) : `PDF లోపం: ${error.message}`);
        }
    }

    function bestVoiceMatch(spokenText) {
        const spoken = spokenText.toLowerCase().trim();
        if (!spoken) return null;

        let bestName = null;
        let bestScore = 0;
        for (const name of schemeNames) {
            const data = schemesCatalog[name];
            if (!data) continue;
            const words = [
                name,
                data.telugu_name,
                data.category,
                data.target_group,
                data.coverage,
                ...(data.keywords || []),
                ...(data.treatments || []),
                ...(data.diseases || [])
            ].filter(Boolean).map(value => String(value).toLowerCase());

            let score = 0;
            for (const word of words) {
                if (!word) continue;
                if (spoken === word) {
                    score += 10;
                } else if (spoken.includes(word) || word.includes(spoken)) {
                    score += 4;
                }
                const pieces = word.split(/\s+/).filter(p => p.length > 2);
                for (const piece of pieces) {
                    if (spoken.includes(piece)) score += 1.5;
                }
            }

            if (score > bestScore) {
                bestScore = score;
                bestName = name;
            }
        }
        return bestScore >= 3 ? bestName : null;
    }

    let recognition = null;
    let isVoiceListening = false;
    if ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window) {
        const SpeechRecognition = window.webkitSpeechRecognition || window.SpeechRecognition;
        recognition = new SpeechRecognition();
        recognition.lang = window.getLang && window.getLang() === 'en' ? 'en-IN' : 'te-IN';
        recognition.continuous = false;
        recognition.interimResults = true;
    }

    function setupVoice() {
        const voiceBtn = document.getElementById('voiceBtn');
        const status = document.getElementById('voiceStatus');
        const searchInput = document.getElementById('searchInput');
        if (!voiceBtn || !status) return;

        function updateVoiceTooltips() {
            const titleText = window.t ? window.t('voiceBtnTitle') : 'వాయిస్ ద్వారా వెతకండి (తెలుగు / English)';
            const ariaText = window.t ? window.t('voiceBtnAria') : 'వాయిస్ ద్వారా వెతకండి';
            voiceBtn.setAttribute('title', titleText);
            voiceBtn.setAttribute('aria-label', ariaText);
        }
        updateVoiceTooltips();

        if (!recognition) {
            voiceBtn.addEventListener('click', () => {
                const notSup = window.t ? window.t('voiceNotSupported') : (window.getLang && window.getLang() === 'en' ? 'Voice recognition not supported in this browser.' : 'ఈ బ్రౌజర్ వాయిస్ సెర్చ్‌కు మద్దతు ఇవ్వదు.');
                status.className = 'voice-status';
                status.textContent = notSup;
            });
            return;
        }

        voiceBtn.addEventListener('click', () => {
            if (isVoiceListening) {
                try {
                    recognition.stop();
                } catch (_) {}
                return;
            }

            const currentLang = window.getLang && window.getLang() === 'en' ? 'en-IN' : 'te-IN';
            recognition.lang = currentLang;

            try {
                recognition.start();
                isVoiceListening = true;
                voiceBtn.classList.add('listening');
                voiceBtn.setAttribute('aria-pressed', 'true');
                status.className = 'voice-status active-listening';
                status.innerHTML = `<span class="listening-dot">🔴</span> ${window.t ? window.t('voiceListening') : (currentLang === 'en-IN' ? 'Listening... please speak' : 'వింటున్నాం... మాట్లాడండి')}`;
            } catch (_error) {
                isVoiceListening = false;
                voiceBtn.classList.remove('listening');
                voiceBtn.setAttribute('aria-pressed', 'false');
                status.className = 'voice-status';
                status.textContent = window.t ? window.t('voiceStartError') : 'మైక్ ప్రారంభం కాలేదు. మళ్లీ ప్రయత్నించండి.';
            }
        });

        recognition.onresult = event => {
            let interimTranscript = '';
            let finalTranscript = '';

            for (let i = event.resultIndex; i < event.results.length; ++i) {
                if (event.results[i].isFinal) {
                    finalTranscript += event.results[i][0].transcript;
                } else {
                    interimTranscript += event.results[i][0].transcript;
                }
            }

            const spoken = (finalTranscript || interimTranscript).trim();

            if (interimTranscript && !finalTranscript) {
                status.className = 'voice-status active-listening';
                status.innerHTML = `🎙️ <em>"${spoken}..."</em>`;
                if (searchInput) {
                    searchInput.value = spoken;
                }
                return;
            }

            if (finalTranscript) {
                const cleanQuery = finalTranscript.trim();
                if (cleanQuery && cleanQuery.length >= 2 && window.SmartGovUX?.addRecentSearch) {
                    window.SmartGovUX.addRecentSearch(cleanQuery);
                }

                if (searchInput) {
                    searchInput.value = cleanQuery;
                    renderSchemeCards(true);
                }

                const match = bestVoiceMatch(cleanQuery);
                const isEn = window.getLang && window.getLang() === 'en';

                if (match) {
                    const schemeObj = schemesCatalog[match];
                    const displayName = (isEn ? (schemeObj?.english_name || match) : (schemeObj?.telugu_name || match));
                    status.className = 'voice-status match-found';
                    status.innerHTML = `🎯 <strong>${displayName}</strong> (${isEn ? 'Opening scheme details...' : 'పథకం వివరాలు తెరుస్తున్నాం...'})`;
                    fetchScheme(match);
                } else {
                    const matchedCards = document.querySelectorAll('.scheme-card:not([style*="display: none"])').length;
                    status.className = 'voice-status';
                    status.innerHTML = `🔍 <strong>"${cleanQuery}"</strong> &bull; ${matchedCards} ${isEn ? 'schemes found' : 'పథకాలు లభించాయి'}`;
                }
            }
        };

        recognition.onerror = event => {
            isVoiceListening = false;
            voiceBtn.classList.remove('listening');
            voiceBtn.setAttribute('aria-pressed', 'false');
            const errCode = event.error || 'unknown';
            const localizedMsg = window.SmartGovI18n ? window.SmartGovI18n.getLocalizedMicError(errCode) : (window.getLang && window.getLang() === 'en' ? `Microphone error: ${errCode}` : `మైక్ లోపం: ${errCode}`);
            status.className = 'voice-status';
            status.textContent = localizedMsg;
        };

        recognition.onend = () => {
            isVoiceListening = false;
            voiceBtn.classList.remove('listening');
            voiceBtn.setAttribute('aria-pressed', 'false');
        };
    }

    function setupInstallPrompt() {
