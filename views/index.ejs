    async function safeFetch(url, options) {
        const response = await fetch(url, options);
        let data;
        const contentType = response.headers.get('content-type') || '';
        if (contentType.includes('application/json')) {
            data = await response.json();
        } else {
            const text = await response.text();
            data = {
                status: 'error',
                error: response.ok
                    ? 'Unexpected response format'
                    : (window.t ? window.t('serverError') : 'సర్వర్ లోపం. దయచేసి మళ్ళీ ప్రయత్నించండి.'),
                error_code: 'NON_JSON_RESPONSE'
            };
        }
        if (!response.ok && !data.error) {
            data.error = window.t ? window.t('serverError') : 'సర్వర్ లోపం. దయచేసి మళ్ళీ ప్రయత్నించండి.';
        }
        return data;
    }

    window.fetchScheme = async function fetchScheme(schemeName) {
        showLoading();
        const detailSection = document.getElementById('schemeDetail') || document.getElementById('resultArea');
        if (detailSection) {
            detailSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
        try {
            const data = await safeFetch("/simplify", {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRFToken': csrfToken
                },
                body: JSON.stringify({ scheme_name: schemeName })
            });
            displayResult(data);
            if (detailSection) {
                detailSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        } catch (error) {
            const offlineData = window.SmartGovEnhanced?.loadOfflineData();
            const cachedScheme = offlineData?.schemes_list?.[schemeName];
            if (cachedScheme) {
                displayResult({
                    request_id: null,
                    scheme_name: schemeName,
                    level: 'Cached copy',
                    category: cachedScheme.category || '',
                    source_name: 'Cached SmartGovAI data',
                    source_url: '',
                    simplified: cachedScheme.simplified,
                    telugu: cachedScheme.telugu,
                    voice_url: cachedScheme.voice_url
                });
                if (detailSection) {
                    detailSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
                return;
            }
            showError(window.t ? window.t('networkError', { error: error.message }) : `నెట్ వర్క్ లోపం: ${error.message}`);
        }
    };

    async function sendFeedback(rating) {
        const reqId = currentRequestId || (currentSchemeName ? 'scheme_' + encodeURIComponent(currentSchemeName) : 'anon_' + Date.now());
        const status = document.getElementById('feedbackStatus');
        if (status) status.textContent = window.t ? window.t('feedbackSaving') : 'సేవ్ చేస్తున్నాం...';
        try {
            const data = await safeFetch("/feedback", {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-CSRFToken': csrfToken
                },
                body: JSON.stringify({ request_id: reqId, rating: Number(rating) })
            });
            if (status) {
                status.textContent = data.status === 'success' ? (window.t ? window.t('feedbackSuccess') : '✅ ధన్యవాదాలు! మీ స్పందన సేవ్ అయింది.') : (window.t ? window.t('feedbackError') : `లోపం: ${data.error}`);
            }
        } catch (error) {
            if (status) {
                status.textContent = window.t ? window.t('networkError', { error: error.message }) : `లోపం: ${error.message}`;
            }
        }
    }

    function populateSchemeDropdown(lang) {
        const select = document.getElementById('schemeSelect');
