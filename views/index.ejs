<!-- Scripts Loading -->
<script src="/static/leaflet/leaflet.js"></script>
<script src="/static/i18n.js"></script>
<script src="/static/enhanced-features.js"></script>

<script nonce="<%= csp_nonce %>">
    const schemesCatalog = <%- JSON.stringify(schemes) %>;
    window.schemesCatalog = schemesCatalog;
    const schemeNames = <%- JSON.stringify(scheme_names) %>;
    const csrfToken = document.querySelector('meta[name="csrf-token"]').getAttribute('content');
    const iconMap = {
        hospital: '🏥',
        ambulance: '🚑',
        'mobile-clinic': '🩺',
        shield: '🛡️',
        clinic: '🏥',
        'phone-doctor': '📱',
        diet: '🥗',
        eye: '👁️',
        baby: '👶',
        kidney: '🫘',
        nutrition: '🥣',
        medicine: '💊',
        maternal: '🤰',
        emergency: '🚨',
        insurance: '🛡️',
        mental: '🧠',
        tb: '🫁'
    };

    let activeFilter = 'all';
    let currentRequestId = null;
    let currentSchemeName = null;
    let currentSchemeData = null;
    let deferredInstallPrompt = null;

    // Pre-compute lowercase search haystacks once on load to optimize performance
    const searchHaystacks = {};
    for (const name of schemeNames) {
        searchHaystacks[name] = haystackFor(name, schemesCatalog[name]);
    }

    function haystackFor(name, data) {
        return [
            name,
            data.telugu_name || '',
            data.category || '',
            data.level || '',
            data.english_description || '',
            data.telugu_description || '',
            ...(data.keywords || [])
        ].join(' ').toLowerCase();
    }

    function matchesFilter(data) {
        if (activeFilter === 'all') return true;
        if (activeFilter === 'ap') return data.level === 'Andhra Pradesh';
        return data.level === 'National';
    }

    let lastQuery = '';
    let lastFilter = null;
    let lastLang = null;

    function renderSchemeCards(force = false) {
        const rawQuery = document.getElementById('searchInput').value.trim();
        const query = rawQuery.toLowerCase();
        const grid = document.getElementById('schemesGrid');
        const countBadge = document.getElementById('schemeCountBadge');
        if (!grid) return;

        const currentLang = window.getLang ? window.getLang() : 'te';

        if (!force && query === lastQuery && activeFilter === lastFilter && currentLang === lastLang) {
            return;
        }
        lastQuery = query;
        lastFilter = activeFilter;
        lastLang = currentLang;

        let filtered = schemeNames.filter(name => {
            const data = schemesCatalog[name];
            if (!data) return false;

            if (activeFilter === 'favorites') {
                return window.SmartGovUX ? window.SmartGovUX.isFavorite(name) : false;
            }

            if (!matchesFilter(data)) return false;
            if (!query) return true;

            return searchHaystacks[name].includes(query);
        });

        if (countBadge) {
            countBadge.textContent = filtered.length;
        }

        if (filtered.length === 0) {
            const emptyMsg = activeFilter === 'favorites'
                ? (window.t ? window.t('noFavoritesMsg') : 'ఇష్టమైన పథకాలు ఏవీ లేవు. పథకం కార్డుపై ఉన్న ★ నక్షత్రాన్ని నొక్కి ఇష్టమైనదిగా చేర్చుకోండి.')
                : (window.t ? window.t('noSchemesFound') : 'ఎలాంటి పథకాలు దొరకలేదు.');
            grid.innerHTML = `<div class="grid-empty-msg">${window.escapeHtml(emptyMsg)}</div>`;
            return;
        }

        const isEn = currentLang === 'en';

        grid.innerHTML = filtered.map(name => {
            const data = schemesCatalog[name];
            const levelClass = data.level === 'Andhra Pradesh' ? 'level-ap' : 'level-national';
            const levelLabel = window.SmartGovI18n ? window.SmartGovI18n.translateLevel(data.level) : (data.level === 'Andhra Pradesh' ? 'ఆంధ్రప్రదేశ్' : 'జాతీయ');
            const categoryLabel = window.SmartGovI18n ? window.SmartGovI18n.translateCategory(data.category) : (data.category || '');
            const isFavorite = window.SmartGovUX ? window.SmartGovUX.isFavorite(name) : false;
            const primaryTitle = isEn ? name : (data.telugu_name || name);
            const secondaryTitle = isEn ? categoryLabel : name;
            const benefitHighlight = isEn ? (data.benefit_amount || data.coverage_type) : (data.benefit_amount_te || data.benefit_amount || data.coverage_type_te || data.coverage_type);
            const favTitle = window.t ? window.t('favoriteBtnTitle') : 'Favorite';
            const listenLabel = isEn ? 'Listen' : 'వినండి';
            const slidesLabel = isEn ? 'Slides' : 'స్లైడ్లు';
            const detailsLabel = isEn ? 'Details' : 'వివరాలు';
            const cardIcon = iconMap[data.icon] || '🏥';

            return `
                <div class="scheme-card" data-action="open-scheme" data-scheme="${window.escapeHtml(name)}" role="button" tabindex="0" aria-label="${window.escapeHtml(primaryTitle)}">
                    <div class="scheme-card-header">
                        <div class="scheme-badges">
                            <span class="level-badge ${levelClass}">${levelLabel}</span>
                            <span class="category-badge"><span class="card-icon" aria-hidden="true">${cardIcon}</span> ${window.escapeHtml(categoryLabel)}</span>
                        </div>
                        <button type="button" class="favorite-btn ${isFavorite ? 'active' : ''}" data-scheme="${window.escapeHtml(name)}" title="${favTitle}" aria-label="Toggle favorite">
                            ${isFavorite ? '★' : '☆'}
                        </button>
                    </div>
                    <div class="scheme-card-body">
                        <h2 class="scheme-card-title">${window.escapeHtml(primaryTitle)}</h2>
                        <p class="scheme-card-subtitle">${window.escapeHtml(secondaryTitle)}</p>
                        ${benefitHighlight ? `<div class="scheme-card-highlight"><span class="highlight-tag">💰 ${window.escapeHtml(benefitHighlight)}</span></div>` : ''}
                    </div>
                    <div class="scheme-card-actions">
                        <button type="button" class="card-action-btn audio-btn" data-action="listen-scheme" data-scheme="${window.escapeHtml(name)}" title="${listenLabel}">
                            <span>🔊</span> ${listenLabel}
                        </button>
                        <button type="button" class="card-action-btn slides-btn" data-action="open-guided" data-scheme="${window.escapeHtml(name)}" title="${slidesLabel}">
                            <span>🖼️</span> ${slidesLabel}
                        </button>
                        <button type="button" class="card-action-btn details-btn" data-action="open-scheme" data-scheme="${window.escapeHtml(name)}" title="${detailsLabel}">
                            <span>📋</span> ${detailsLabel}
                        </button>
                    </div>
                </div>
            `;
        }).join('');
    }

    function showLoading(message) {
        const loadingMsg = message || (window.t ? window.t('loadingDetails') : 'వివరాలు తెస్తున్నాం...');
        document.getElementById('resultArea').innerHTML = `<div class="loading">${window.escapeHtml(loadingMsg)}</div>`;
    }

    function showError(message) {
        document.getElementById('resultArea').innerHTML = `
            <div class="result-inner">
                <p class="error">${window.escapeHtml(message)}</p>
            </div>
        `;
    }

    function resultCard(title, text) {
        return `
            <article class="info-card">
                <h3>${window.escapeHtml(title)}</h3>
                <p>${window.escapeHtml(text)}</p>
            </article>
        `;
    }

    function displayResult(data) {
        if (data.error) {
            showError(data.error);
            return;
        }

        currentRequestId = data.request_id;
        currentSchemeName = data.scheme_name;
        currentSchemeData = data;
        window.currentRequestId = data.request_id;
        window.currentSchemeName = data.scheme_name;
        const scheme = schemesCatalog[data.scheme_name] || {};

        const currentLang = window.getLang ? window.getLang() : 'te';
        const isEn = currentLang === 'en';

        const levelLabel = window.SmartGovI18n ? window.SmartGovI18n.translateLevel(data.level) : (data.level || '');
        const categoryLabel = window.SmartGovI18n ? window.SmartGovI18n.translateCategory(data.category) : (data.category || '');
        const mainTitle = isEn ? (data.scheme_name || '') : (scheme.telugu_name || data.scheme_name || '');
        const subTitle = isEn ? (categoryLabel || '') : (data.scheme_name || '');

        const audioTitle = window.t ? window.t('audioTitle') : '🎙️ ఆడియో గైడ్';
        const audioNotAvail = window.t ? window.t('audioNotAvailable') : 'ఆడియో అందుబాటులో లేదు';

        const audioHtml = data.voice_url && !isEn
            ? `<div class="audio-wrap">
                <strong>${audioTitle}</strong>
                <audio controls src="${window.escapeHtml(data.voice_url)}" style="width: 100%;" onerror="this.parentElement.innerHTML = '<button type=\\'button\\' class=\\'speak-page-btn primary-btn\\' style=\\'width:100%;margin-top:8px;padding:8px;\\'>🔊 Read Aloud (Browser Voice)</button>';"></audio>
            </div>`
            : (isEn
                ? `<div class="audio-wrap">
                    <strong>${audioTitle}</strong>
                    <button type="button" class="speak-page-btn primary-btn" style="width:100%;margin-top:8px;padding:8px;">${window.t ? window.t('speakPageBtn') : '🔊 Read Aloud (Browser Voice)'}</button>
                </div>`
                : `<div class="audio-wrap">
                    <strong>${audioNotAvail}</strong>
                    <button type="button" class="speak-page-btn primary-btn" style="width:100%;margin-top:8px;padding:8px;background:var(--secondary);color:#000;">⚠️ ${window.t ? window.t('speakPageBtn') : '🔊 ఈ పేజీ చదవండి (Browser Fallback)'}</button>
                   </div>`);

        const sourceLabel = window.t ? window.t('sourceLabel') : 'మూలం:';
        const officialSource = window.t ? window.t('officialSource') : 'అధికారిక మూలం';
        const uploadedSource = window.t ? window.t('uploadedSource') : 'అప్‌లోడ్ చేసిన పత్రం';

        const sourceHtml = data.source_url
            ? `<a class="source-link" href="${window.escapeHtml(data.source_url)}" target="_blank" rel="noopener noreferrer">🌐 ${window.escapeHtml(data.source_name || officialSource)}</a>`
            : `<span>📄 ${window.escapeHtml(data.source_name || uploadedSource)}</span>`;

        const aiBadge = data.is_ai_generated ? `<span class="ai-badge" style="background:#e8f0fe; color:#1a73e8; padding:2px 8px; border-radius:12px; font-size:0.8rem; margin-left:8px; display:inline-block; vertical-align:middle;" title="This information is generated by AI from the uploaded document">✨ AI-Generated</span>` : '';
        const aiDisclaimer = data.is_ai_generated ? `<div class="privacy-warning" style="background:#fff3cd; color:#856404; border:1px solid #ffeeba; margin-top:10px;">⚠️ ఈ సమాచారం AI ద్వారా పత్రం నుండి తీసుకోబడింది. ఇది అధికారిక ప్రభుత్వ ప్రకటన కాదు. (AI-generated explanation, not an official government statement)</div>` : '';

        const richDetailsHtml = SmartGovEnhanced.buildRichDetails ? SmartGovEnhanced.buildRichDetails(scheme) : '';
        const eligibilityChecker = SmartGovEnhanced.buildEligibilityChecker(scheme);
        const documentChecklist = SmartGovEnhanced.buildDocumentChecklist(scheme);
        const trustInfo = SmartGovEnhanced.buildTrustInfo(scheme);
        const privacyWarning = SmartGovEnhanced.buildPrivacyWarning();

        if (window.SmartGovUX) {
            window.SmartGovUX.addRecent(data.scheme_name);
        }

        const eligContent = isEn ? (data.simplified?.eligibility || '') : (data.telugu?.eligibility || '');
        const benContent = isEn ? (data.simplified?.benefits || '') : (data.telugu?.benefits || '');
        const docContent = isEn ? (data.simplified?.documents || '') : (data.telugu?.documents || '');
        const stepContent = isEn ? (data.simplified?.steps || '') : (data.telugu?.steps || '');

        const eligTitle = window.t ? window.t('eligibilityTitle') : 'అర్హత';
        const benTitle = window.t ? window.t('benefitsTitle') : 'ప్రయోజనాలు';
        const docTitle = window.t ? window.t('documentsTitle') : 'కావలసిన పత్రాలు';
