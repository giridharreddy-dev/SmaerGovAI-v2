<!DOCTYPE html>
<html lang="te">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>Admin Login - SmartGov Health Guide</title>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&family=Noto+Sans+Telugu:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/public/css/theme.css">
    <style>
        .login-card {
            max-width: 420px;
            margin: 80px auto;
            padding: 36px 28px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-md);
            text-align: center;
        }
        .login-card-header {
            margin-bottom: 24px;
        }
        .login-card-header img {
            margin-bottom: 12px;
        }
        .login-card-header h1 {
            margin: 0;
            color: var(--ink);
            font-size: 1.4rem;
        }
        .login-card-header p {
            margin: 4px 0 0;
            color: var(--muted);
            font-size: 0.85rem;
        }
        .form-group {
            margin: 20px 0;
            text-align: left;
        }
        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 700;
            font-size: 0.9rem;
            color: var(--ink);
        }
        .form-group input[type="password"] {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            background: var(--surface-soft);
            color: var(--ink);
            font-size: 1rem;
            box-sizing: border-box;
        }
        .login-btn {
            width: 100%;
            padding: 12px;
            font-size: 1rem;
            font-weight: 800;
        }
        .flash-messages {
            list-style: none;
            padding: 0;
            margin-bottom: 20px;
        }
        .flash-messages li {
            padding: 10px 14px;
            border-radius: var(--radius-md);
            margin-bottom: 10px;
            font-size: 0.9rem;
            background: #ffebee;
            color: #c62828;
            border: 1px solid #ffcdd2;
        }
    </style>
</head>
<body class="dashboard-body">
    <main class="container">
        <div class="login-card">
            <div class="login-card-header">
                <img src="/public/assets/icon.svg" alt="SmartGov Emblem" width="60" height="60" style="border-radius: 50%; box-shadow: 0 4px 14px rgba(0,0,0,0.12); margin-bottom: 10px;" onerror="this.onerror=null; this.src='/public/icon.svg';">
                <h1>🔒 Admin Login</h1>
                <p>SmartGov Health Administration</p>
            </div>
            
            <% if (typeof messages !== 'undefined' && messages && messages.length) { %>
                <ul class="flash-messages">
                <% messages.forEach(function(msg) { %>
                    <li class="<%= msg.category || 'error' %>"><%= msg.text || msg %></li>
                <% }); %>
                </ul>
            <% } %>

            <form method="POST" id="adminLoginForm" action="/admin/login<%= typeof nextUrl !== 'undefined' && nextUrl ? '?next=' + encodeURIComponent(nextUrl) : '' %>">
                <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
                
                <div class="form-group">
                    <label for="token">Admin Security Token:</label>
                    <input type="password" id="token" name="token" required autocomplete="current-password" placeholder="Enter admin token (admin123 or 12345678)">
                    <small style="color: var(--ink-light); display:block; margin-top:6px; font-size:0.8rem;">Default tokens: <code>admin123</code> or <code>12345678</code></small>
                </div>
                
                <button type="submit" class="btn primary-btn login-btn">Login</button>
            </form>

            <div style="margin-top: 18px; padding: 14px; background: rgba(27, 138, 116, 0.08); border: 1px dashed rgba(27, 138, 116, 0.4); border-radius: var(--radius-md); text-align: center;">
                <div style="font-size: 0.82rem; color: var(--ink); font-weight: 600; margin-bottom: 8px;">1-Click Instant Access:</div>
                <a href="/admin?token=admin123" class="btn primary-btn" style="display: block; width: 100%; box-sizing: border-box; text-decoration: none; padding: 10px; font-size: 0.88rem; font-weight: 700; background: var(--primary);">
                    🔓 Open Dashboard with Default Token
                </a>
            </div>

            <div style="margin-top: 20px;">
                <a href="/" class="btn secondary" style="width:100%; box-sizing:border-box; display:inline-block; text-align:center;">← Back to Citizen Home Portal</a>
            </div>
        </div>
    </main>
    <script>
        document.getElementById('adminLoginForm').addEventListener('submit', function(e) {
            const tokenInput = document.getElementById('token').value.trim();
            if (tokenInput) {
                try {
                    sessionStorage.setItem('admin_token', tokenInput);
                    localStorage.setItem('admin_token', tokenInput);
                } catch(err) {}
            }
        });
    </script>
</body>
</html>
