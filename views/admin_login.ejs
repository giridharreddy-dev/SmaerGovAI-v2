<!DOCTYPE html>
<html lang="te">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>Admin Login - SmartGov Health Guide</title>
    <link rel="stylesheet" href="/static/style.css">
    <style>
        .login-card {
            max-width: 420px;
            margin: 80px auto;
            padding: 36px 28px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-md);
            text-align: center;
        }
        .login-card-header {
            margin-bottom: 24px;
        }
        .login-card-header img {
            margin-bottom: 12px;
        }
        .login-card-header h1 {
            margin: 0;
            color: var(--ink);
            font-size: 1.4rem;
        }
        .login-card-header p {
            margin: 4px 0 0;
            color: var(--muted);
            font-size: 0.85rem;
        }
        .form-group {
            margin: 20px 0;
            text-align: left;
        }
        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-weight: 700;
            font-size: 0.9rem;
            color: var(--ink);
        }
        .form-group input[type="password"] {
            width: 100%;
            padding: 12px 14px;
            border: 1px solid var(--border);
            border-radius: var(--radius-md);
            background: var(--surface-soft);
            color: var(--ink);
            font-size: 1rem;
            box-sizing: border-box;
        }
        .login-btn {
            width: 100%;
            padding: 12px;
            font-size: 1rem;
            font-weight: 800;
        }
        .flash-messages {
            list-style: none;
            padding: 0;
            margin-bottom: 20px;
        }
        .flash-messages li {
            padding: 10px 14px;
            border-radius: var(--radius-md);
            margin-bottom: 10px;
            font-size: 0.9rem;
            background: #ffebee;
            color: #c62828;
            border: 1px solid #ffcdd2;
        }
    </style>
</head>
<body class="dashboard-body">
    <main class="container">
        <div class="login-card">
            <div class="login-card-header">
                <img src="/static/icon.svg" alt="Logo" width="48" height="48">
                <h1>🔒 అడ్మిన్ లాగిన్ <small>(Admin Login)</small></h1>
                <p>SmartGov Health Administration</p>
            </div>
            
            <% if (typeof messages !== 'undefined' && messages && messages.length) { %>
                <ul class="flash-messages">
                <% messages.forEach(function(msg) { %>
                    <li class="<%= msg.category || 'error' %>"><%= msg.text || msg %></li>
                <% }); %>
                </ul>
            <% } %>

            <form method="POST" action="/admin/login<%= typeof nextUrl !== 'undefined' && nextUrl ? '?next=' + encodeURIComponent(nextUrl) : '' %>">
                <input type="hidden" name="csrf_token" value="<%= csrf_token %>">
                
                <div class="form-group">
                    <label for="token">అడ్మిన్ టోకెన్ (Admin Token):</label>
                    <input type="password" id="token" name="token" required autocomplete="current-password" placeholder="Enter admin token">
                </div>
                
                <button type="submit" class="btn primary-btn login-btn">లాగిన్ (Login)</button>
            </form>
            <div style="margin-top: 24px;">
                <a href="/" class="btn secondary" style="width:100%; box-sizing:border-box; display:inline-block; text-align:center;">← ప్రధాన పేజీ (Back to Main)</a>
            </div>
        </div>
    </main>
</body>
</html>
